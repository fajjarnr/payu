# PayU Digital Banking - Production Environment Variables Template
# ============================================================================
# Template for production configurations.
# DO NOT include real passwords here.
# Production secrets MUST be loaded from Vault or OpenShift Secrets!
# ============================================================================

# Build Metadata
BUILD_DATE=2026-07-02T00:00:00Z
GIT_COMMIT=production-commit-sha
VERSION=1.8.71

# Application Settings
APP_ENV=production
APP_DEBUG=false  # STRICT: Must be false in production
LOG_LEVEL=info   # info or warn in production
TZ=Asia/Jakarta

# Database - PostgreSQL (Production Settings)
# Target PostgreSQL HA or Crunchy PostgreSQL Operator
POSTGRES_HOST=payu-postgres-ha.payu-db.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=payu_app
POSTGRES_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
POSTGRES_DB=payu_production
POSTGRES_SSL_MODE=verify-full  # STRICT: Enforce full TLS certificate validation

# TimescaleDB (Analytics Service - Production)
TIMESCALE_HOST=payu-timescale.payu-db.svc.cluster.local
TIMESCALE_PORT=5433
TIMESCALE_USER=payu_analytics_app
TIMESCALE_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
TIMESCALE_DB=payu_analytics
TIMESCALE_SSL_MODE=verify-full

# Cache - Redis/Data Grid (Production Settings)
REDIS_HOST=payu-redis-cluster.payu-cache.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
REDIS_DB=0
REDIS_SSL=true  # STRICT: Enable TLS

# Data Grid
DATAGRID_HOST=payu-datagrid.payu-cache.svc.cluster.local
DATAGRID_PORT=11222
DATAGRID_USERNAME=payu_app
DATAGRID_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT

# Message Broker - Kafka/AMQ (Production Settings)
KAFKA_BOOTSTRAP_SERVERS=payu-kafka-cluster-kafka-bootstrap.payu-messaging.svc.cluster.local:9092
KAFKA_GROUP_ID=payu-services-prod
KAFKA_SECURITY_PROTOCOL=SASL_SSL  # STRICT: Secure Kafka protocol
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=payu-client
KAFKA_SASL_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
KAFKA_AUTO_OFFSET_RESET=earliest

# AMQ Broker (Artemis)
AMQ_BROKER_URL=failover:(ssl://payu-artemis-0.payu-messaging.svc:61616,ssl://payu-artemis-1.payu-messaging.svc:61616)
AMQ_BROKER_USERNAME=payu_app
AMQ_BROKER_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT

# Identity - Keycloak (Production Settings)
KEYCLOAK_URL=https://sso.payu.id
KEYCLOAK_REALM=payu
KEYCLOAK_CLIENT_ID=payu-backend
KEYCLOAK_CLIENT_SECRET=REQUIRED_SECURE_SECRET_FROM_VAULT
KEYCLOAK_ADMIN_USER=payu_admin
KEYCLOAK_ADMIN_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT

# Secrets - HashiCorp Vault (Production Settings - Kubernetes Auth)
VAULT_ADDR=https://vault.payu-security.svc.cluster.local:8200
VAULT_ROLE=payu-service-role
VAULT_AUTH_METHOD=kubernetes  # Use Kubernetes service account token for Vault login

# External Services Simulators (STRICT: DISABLED in Production)
BIFAST_API_URL=https://api.bifast.or.id/v1
BIFAST_CLIENT_ID=REQUIRED_PRODUCTION_CLIENT_ID
BIFAST_CLIENT_SECRET=REQUIRED_PRODUCTION_SECRET
BIFAST_TIMEOUT=15000

DUKCAPIL_API_URL=https://api.dukcapil.kemendagri.go.id/v1
DUKCAPIL_API_KEY=REQUIRED_PRODUCTION_API_KEY
DUKCAPIL_TIMEOUT=10000

QRIS_API_URL=https://api.qris-processor.co.id/v1
QRIS_MERCHANT_ID=REQUIRED_PRODUCTION_MERCHANT_ID
QRIS_CLIENT_ID=REQUIRED_PRODUCTION_CLIENT_ID
QRIS_CLIENT_SECRET=REQUIRED_PRODUCTION_SECRET
QRIS_TIMEOUT=15000

# Observability - OpenTelemetry (Production Settings)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.payu-monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=payu-core-service
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1  # Sample 10% of traces in production to manage span volume

# Feature Flags
FEATURE_BIFAST_ENABLED=true
FEATURE_QRIS_ENABLED=true
FEATURE_VIRTUAL_CARDS_ENABLED=true
FEATURE_INVESTMENT_ENABLED=false  # Disabled until compliance sign-off
FEATURE_LENDING_ENABLED=false
FEATURE_FX_TRADING_ENABLED=false
FEATURE_EXPERIMENTAL_UI_ENABLED=false
FEATURE_BETA_ANALYTICS_ENABLED=false

# Python FastAPI Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
WORKERS=4

# Node.js Settings
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0
