# PayU Digital Banking - Local Development Environment Variables Template
# ============================================================================
# Copy this file to .env and update with your values for local development.
# NEVER commit the actual .env file to version control!
# ============================================================================

# Build Metadata
BUILD_DATE=2026-07-02T00:00:00Z
GIT_COMMIT=dev-commit
VERSION=1.8.71-dev

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
TZ=Asia/Jakarta

# Database - PostgreSQL (Local Dev Defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payu
POSTGRES_PASSWORD=payu_dev_secret_password_1234
POSTGRES_DB=payu_account
POSTGRES_SSL_MODE=disable  # Disabled for local development

# TimescaleDB (Analytics Service - Local Dev)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=payu_analytics
TIMESCALE_PASSWORD=payu_analytics_dev_pass_123
TIMESCALE_DB=payu_analytics
TIMESCALE_SSL_MODE=disable

# Cache - Redis/Data Grid (Local Dev Defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# Data Grid
DATAGRID_HOST=localhost
DATAGRID_PORT=11222
DATAGRID_USERNAME=payu
DATAGRID_PASSWORD=payu_datagrid_dev_pass

# Message Broker - Kafka/AMQ (Local Dev Defaults)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=payu-services-dev
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_AUTO_OFFSET_RESET=earliest

# AMQ Broker (Artemis)
AMQ_BROKER_URL=tcp://localhost:61616
AMQ_BROKER_USERNAME=payu
AMQ_BROKER_PASSWORD=payu_artemis_dev_pass

# Identity - Keycloak (Local Dev Defaults)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=payu
KEYCLOAK_CLIENT_ID=payu-backend
KEYCLOAK_CLIENT_SECRET=payu-keycloak-dev-client-secret-12345
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pass_1234

# Secrets - HashiCorp Vault (Local Dev Defaults)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-root-token-id-12345

# External Services Simulators (Enabled for Dev)
BIFAST_API_URL=http://localhost:8090
BIFAST_CLIENT_ID=payu_test
BIFAST_CLIENT_SECRET=bifast_test_secret
BIFAST_TIMEOUT=30000

DUKCAPIL_API_URL=http://localhost:8091
DUKCAPIL_API_KEY=dukcapil_test_key
DUKCAPIL_TIMEOUT=15000

QRIS_API_URL=http://localhost:8092
QRIS_MERCHANT_ID=1234567890
QRIS_CLIENT_ID=payu_qris
QRIS_CLIENT_SECRET=qris_test_secret
QRIS_TIMEOUT=30000

# Observability - OpenTelemetry (Local Dev Defaults)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=payu-service-dev
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Service Ports
ACCOUNT_SERVICE_PORT=8001
AUTH_SERVICE_PORT=8002
TRANSACTION_SERVICE_PORT=8003
WALLET_SERVICE_PORT=8004
BILLING_SERVICE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006
GATEWAY_SERVICE_PORT=8000
KYC_SERVICE_PORT=8010
ANALYTICS_SERVICE_PORT=8011
INVESTMENT_SERVICE_PORT=8007
LENDING_SERVICE_PORT=8008
FX_SERVICE_PORT=8009
STATEMENT_SERVICE_PORT=8012
BACKOFFICE_SERVICE_PORT=8013
PARTNER_SERVICE_PORT=8014
PROMOTION_SERVICE_PORT=8015
SUPPORT_SERVICE_PORT=8016
COMPLIANCE_SERVICE_PORT=8017
CMS_SERVICE_PORT=8018
API_PORTAL_SERVICE_PORT=8020

# Feature Flags (All Dev Features Allowed)
FEATURE_BIFAST_ENABLED=true
FEATURE_QRIS_ENABLED=true
FEATURE_VIRTUAL_CARDS_ENABLED=true
FEATURE_INVESTMENT_ENABLED=true
FEATURE_LENDING_ENABLED=true
FEATURE_FX_TRADING_ENABLED=true
FEATURE_EXPERIMENTAL_UI_ENABLED=true
FEATURE_BETA_ANALYTICS_ENABLED=true

# Python FastAPI Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
WORKERS=2

# Node.js Settings
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=localhost
