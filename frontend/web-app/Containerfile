####
# Base Image - Red Hat UBI9 Node.js 24
####
FROM registry.access.redhat.com/ubi9/nodejs-24@sha256:2de19f9aed8524187e52c146da60635a80adb06739f23519a5c8a16fda2850e5 AS base
ARG APP_VERSION=1.5.0

# Metadata labels
LABEL maintainer="frontend-team@payu.fajjjar.my.id"
LABEL description="PayU Web App - Digital Banking Next.js Frontend"
LABEL version="${APP_VERSION}"
LABEL org.opencontainers.image.title="payu-web-app"
LABEL org.opencontainers.image.description="PayU Digital Banking Web Application - Next.js 16 with React 19, TypeScript, and Tailwind CSS"
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.url="https://payu.fajjjar.my.id"
LABEL org.opencontainers.image.source="https://github.com/payu/frontend/web-app"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.authors="PayU Frontend Team"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL id.payu.service.tier="1"
LABEL id.payu.compliance.pci-dss="false"
LABEL id.payu.security.scan-level="high"
LABEL id.payu.service.domain="frontend"

####
# Stage 1: Dependencies
####
FROM base AS deps
USER root
WORKDIR /app

# Install build tools for native modules and libraries needed for Playwright
# UBI9 compatible package names - libnsl2 instead of libnsl, no xdg-utils needed
RUN dnf install -y python3 make gcc-c++ libX11 libXcomposite libXcursor libXdamage libXext libXi libXtst cups-libs libXScrnSaver libxkbcommon at-spi2-atk alsa-lib nss && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies with npm ci for reliable, reproducible builds.
RUN npm ci

####
# Stage 2: Builder
####
FROM base AS builder
USER root
WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# Disable Next.js telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Build-time arguments for environment variables
# NEXT_PUBLIC_* must be available at build time
ARG NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Build Next.js application with standalone output for minimal container size
RUN npm run build

####
# Stage 3: Minimal production runner
####
FROM registry.access.redhat.com/ubi9/nodejs-24@sha256:2de19f9aed8524187e52c146da60635a80adb06739f23519a5c8a16fda2850e5 AS runner

WORKDIR /app

# Environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=8080
ENV HOSTNAME="0.0.0.0"

# Create non-root user directory and set permissions
USER root

# Copy public assets (static files)
COPY --from=builder /app/public ./public

# Create .next directory with proper permissions for OpenShift
RUN mkdir -p .next && chown -R 1001:0 .next

# Copy standalone output (optimized for container deployment)
COPY --from=builder --chown=1001:0 /app/.next/standalone ./
COPY --from=builder --chown=1001:0 /app/.next/static ./.next/static

# Switch to non-root user (1001 is the default node user in UBI9)
USER 1001

# Expose the application port
EXPOSE 8080

# Run the production server
CMD ["node", "server.js"]
