# ============================================
# PayU Web App - Next.js Docker Ignore
# ============================================
# This file provides dockerignore patterns optimized for
# Next.js 15+ React applications with TypeScript.

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.pnp/
.pnp.js

# --- Next.js Build Output ---
.next/
out/
build/
dist/

# --- Testing & Coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
.vitest/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
**/__tests__/
cypress/

# --- Turborepo (if used) ---
.turbo/

# --- Environment Files ---
.env
.env.*
!.env.example
.env.local
.env.development
.env.test
.env.production
.env.production.local

# --- Vercel ---
.vercel/
.now/

# --- TypeScript & Build Cache ---
*.tsbuildinfo
next-env.d.ts
.turbo/

# --- IDE & Editor Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.factorypath
*.iml
*.sublime-project
*.sublime-workspace
.history/

# --- Logs & Debug ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Git ---
.git/
.gitignore
.gitattributes
.github/

# --- Docker (prevent self-inclusion) ---
Dockerfile*
.dockerignore
docker-compose*.yml

# --- Documentation (exclude from build context) ---
*.md
README.md
CHANGELOG.md
LICENSE
CONTRIBUTING.md
docs/
!docs/build/

# --- CI/CD ---
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.jenkinsfile
.circleci/

# --- Misc ---
.editorconfig
.prettierrc*
.eslintrc*
.prettierignore
.turbo/
VERCEL_DEPLOYMENT_HANDLER
.netlify/

# --- Storybook (if used) ---
.storybook/
storybook-static/

# --- Temporary Files ---
tmp/
temp/
*.tmp
.cache/

# --- PWA / Service Worker Files (rebuild during build) ---
**/public/sw.js
**/public/workbox*.js
**/public/worker-*.js
**/public/fallback*.js
