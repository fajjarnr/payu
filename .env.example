# PayU Digital Banking - Environment Variables Template
# ============================================================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control!
#
# Security Instructions:
# 1. cp .env.example .env
# 2. chmod 600 .env (restrictive permissions)
# 3. Generate secure passwords (see PASSWORD_GENERATION below)
# 4. Use different passwords for production
# ============================================================================

# ============================================================================
# PASSWORD_GENERATION - How to Generate Secure Passwords
# ============================================================================
#
# Use one of these methods to generate secure passwords:
#
# Method 1: OpenSSL (recommended for production)
#   openssl rand -base64 32
#
# Method 2: Python (for quick testing)
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Method 3: /dev/urandom (Linux/Mac)
#   tr -dc 'A-Za-z0-9!@#$%^&*' < /dev/urandom | head -c 32
#
# Password Requirements:
# - Minimum 32 characters for production
# - Minimum 16 characters for development
# - Mix of uppercase, lowercase, numbers, and special characters
# - Rotate passwords every 90 days (OJK compliance)
# ============================================================================

# ============================================================================
# BUILD METADATA - For Container Image Labels
# ============================================================================

# Build timestamp (ISO 8601 format, UTC)
# Usage: date -u +'%Y-%m-%dT%H:%M:%SZ'
BUILD_DATE=2026-01-30T00:00:00Z

# Git commit SHA (short)
# Usage: git rev-parse --short HEAD
GIT_COMMIT=00000000

# Build version
VERSION=1.0.0

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application Environment: development, staging, production
APP_ENV=development

# Debug mode (MUST be false in production)
APP_DEBUG=true

# Log level: debug, info, warn, error
# Production should use 'info' or 'warn'
LOG_LEVEL=debug

# Timezone
TZ=Asia/Jakarta

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================

# Primary Database (Account Service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payu
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_postgres_password_here_minimum_32_chars
POSTGRES_DB=payu_account
POSTGRES_SSL_MODE=disable  # Use 'require' or 'verify-full' in production

# Connection Pool Settings
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_CONNECTION_TIMEOUT=30

# TimescaleDB (Analytics Service)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=payu_analytics
# Generate with: openssl rand -base64 32
TIMESCALE_PASSWORD=your_secure_timescale_password_here_minimum_32_chars
TIMESCALE_DB=payu_analytics
TIMESCALE_SSL_MODE=disable

# ============================================================================
# CACHE - Redis/Data Grid
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local development (no authentication)
# For production, generate with: openssl rand -base64 32
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false  # Set to true in production
REDIS_MAX_RETRIES=3
REDIS_TIMEOUT=5000

# Data Grid (JCache/Infinispan alternative)
DATAGRID_HOST=localhost
DATAGRID_PORT=11222
DATAGRID_USERNAME=payu
DATAGRID_PASSWORD=your_secure_datagrid_password_here

# ============================================================================
# MESSAGE BROKER - Kafka/AMQ Streams
# ============================================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=payu-services
KAFKA_SECURITY_PROTOCOL=PLAINTEXT  # Use SASL_SSL in production
KAFKA_AUTO_OFFSET_RESET=earliest

# For production with SASL_SSL:
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=payu-producer
# KAFKA_SASL_PASSWORD=your_secure_kafka_password

# AMQ Broker (Artemis) - For JMS/AMQP messages
AMQ_BROKER_URL=tcp://localhost:61616
AMQ_BROKER_USERNAME=payu
AMQ_BROKER_PASSWORD=your_secure_amq_password_here

# ============================================================================
# IDENTITY - Keycloak/Red Hat SSO
# ============================================================================

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=payu
KEYCLOAK_CLIENT_ID=payu-backend
# Generate with: openssl rand -base64 48
KEYCLOAK_CLIENT_SECRET=your_secure_keycloak_client_secret_here_minimum_48_chars

# Keycloak Admin Console
KEYCLOAK_ADMIN_USER=admin
# Generate with: openssl rand -base64 32
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password_here_minimum_32_chars

# ============================================================================
# SECRETS - HashiCorp Vault
# ============================================================================

VAULT_ADDR=http://localhost:8200
# For development: Use root token (NOT for production)
# Generate with: openssl rand -base64 32
VAULT_TOKEN=your_secure_vault_token_here_minimum_32_chars

# For production: Use Kubernetes authentication
# VAULT_ROLE=payu-service
# VAULT_AUTH_METHOD=kubernetes

# ============================================================================
# EXTERNAL SERVICES - Simulators (Development Only)
# ============================================================================

# BI-FAST Integration Simulator
BIFAST_API_URL=http://localhost:8090
# For production: Use real BI-FAST credentials
BIFAST_CLIENT_ID=payu_test
BIFAST_CLIENT_SECRET=your_secure_bifast_client_secret
BIFAST_TIMEOUT=30000

# Dukcapil (eKYC) Simulator
DUKCAPIL_API_URL=http://localhost:8091
# For production: Use real Dukcapil API credentials
DUKCAPIL_API_KEY=your_secure_dukcapil_api_key
DUKCAPIL_TIMEOUT=15000

# QRIS Simulator
QRIS_API_URL=http://localhost:8092
# For production: Use real QRIS credentials from QRIS SP
QRIS_MERCHANT_ID=1234567890
QRIS_CLIENT_ID=payu_qris
QRIS_CLIENT_SECRET=your_secure_qris_client_secret
QRIS_TIMEOUT=30000

# ============================================================================
# OBSERVABILITY - OpenTelemetry
# ============================================================================

# OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=payu-service
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Sampling rate (1.0 = 100%, 0.1 = 10%)
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Prometheus (scrape endpoint)
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Loki (log aggregation)
LOKI_URL=http://localhost:3100
LOKI_TENANT_ID=payu

# Jaeger (distributed tracing)
JAEGER_ENDPOINT=http://localhost:4318
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=1.0

# ============================================================================
# SERVICE PORTS - Internal Service Communication
# ============================================================================

# Core Banking Services
ACCOUNT_SERVICE_PORT=8001
AUTH_SERVICE_PORT=8002
TRANSACTION_SERVICE_PORT=8003
WALLET_SERVICE_PORT=8004

# Supporting Services
BILLING_SERVICE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006
GATEWAY_SERVICE_PORT=8000
KYC_SERVICE_PORT=8010
ANALYTICS_SERVICE_PORT=8011

# Additional Services
INVESTMENT_SERVICE_PORT=8007
LENDING_SERVICE_PORT=8008
FX_SERVICE_PORT=8009
STATEMENT_SERVICE_PORT=8012
BACKOFFICE_SERVICE_PORT=8013
PARTNER_SERVICE_PORT=8014
PROMOTION_SERVICE_PORT=8015
SUPPORT_SERVICE_PORT=8016
COMPLIANCE_SERVICE_PORT=8017
CMS_SERVICE_PORT=8018
AB_TESTING_SERVICE_PORT=8019
API_PORTAL_SERVICE_PORT=8020

# ============================================================================
# FEATURE FLAGS - Service Availability Control
# ============================================================================

# Payment Features
FEATURE_BIFAST_ENABLED=true
FEATURE_QRIS_ENABLED=true
FEATURE_VIRTUAL_CARDS_ENABLED=true

# Product Features
FEATURE_INVESTMENT_ENABLED=false
FEATURE_LENDING_ENABLED=false
FEATURE_FX_TRADING_ENABLED=false

# Experimental Features (always false in production)
FEATURE_EXPERIMENTAL_UI_ENABLED=false
FEATURE_BETA_ANALYTICS_ENABLED=false

# ============================================================================
# JVM SETTINGS - Java Services (Spring Boot/Quarkus)
# ============================================================================

# Common JVM options for containers
JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:MinRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:+UnlockExperimentalVMOptions \
    -XX:+UseStringDeduplication"

# Service-specific JVM overrides
# Gateway Service (low latency)
GATEWAY_JAVA_OPTS="-XX:MaxGCPauseMillis=50"

# Analytics Service (high throughput)
ANALYTICS_JAVA_OPTS="-XX:+UseParallelGC"

# ============================================================================
# PYTHON SETTINGS - FastAPI Services
# ============================================================================

# Python runtime configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Worker configuration
WORKERS=4
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
WORKER_TIMEOUT=30

# ============================================================================
# NODE.JS SETTINGS - Next.js Services
# ============================================================================

# Node.js runtime
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Server configuration
PORT=3000
HOSTNAME=0.0.0.0

# ============================================================================
# PRODUCTION vs DEVELOPMENT NOTES
# ============================================================================

# DEVELOPMENT ENVIRONMENT:
# - APP_ENV=development
# - APP_DEBUG=true (safe for local)
# - LOG_LEVEL=debug (verbose logging)
# - Simulators enabled (BIFAST_API_URL=http://localhost:8090)
# - SSL/TLS disabled (POSTGRES_SSL_MODE=disable)
# - Simplified authentication (plaintext passwords)

# PRODUCTION ENVIRONMENT:
# - APP_ENV=production
# - APP_DEBUG=false (CRITICAL - security risk if true)
# - LOG_LEVEL=info or warn (reduce log volume)
# - Real external services (BIFAST, QRIS, Dukcapil)
# - SSL/TLS enabled everywhere (POSTGRES_SSL_MODE=require)
# - SASL_SSL for Kafka
# - Strong passwords (32+ characters, rotated regularly)
# - Secrets from Vault or OpenShift Secrets (NOT .env files)
# - mTLS enabled (service mesh)
# - Rate limiting enabled
# - WAF rules enabled

# ============================================================================
# SECURITY CHECKLIST (Before Deploying to Production)
# ============================================================================

# [ ] APP_DEBUG is set to false
# [ ] LOG_LEVEL is set to info or warn
# [ ] All passwords are 32+ characters
# [ ] All passwords are unique (no reuse)
# [ ] SSL/TLS is enabled for all external connections
# [ ] Secrets are stored in Vault, not .env
# [ ] .env file is NOT committed to git (check .gitignore)
# [ ] File permissions on .env are 600 (chmod 600 .env)
# [ ] All FEATURE_* flags are appropriate for production
# [ ] Simulators are disabled (real APIs used)
# [ ] Observability is enabled (OTEL, Prometheus, Loki)
# [ ] Container images are signed (cosign)
# [ ] Container images are scanned (Trivy/Grype)
# [ ] SBOM is generated and attached to images

# ============================================================================
# SERVICE-SPECIFIC ENVIRONMENT VARIABLES
# ============================================================================

# Account Service
ACCOUNT_MAX_POCKET_COUNT=10
ACCOUNT_BALANCE_PRECISION=2
ACCOUNT_CURRENCY=IDR

# Auth Service
AUTH_JWT_SECRET=your_secure_jwt_secret_use_openssl_rand_base64_64
AUTH_JWT_EXPIRATION_MS=3600000
AUTH_MFA_ENABLED=true
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# Transaction Service
TRANSACTION_BIFAST_ENABLED=true
TRANSACTION_QRIS_ENABLED=true
TRANSACTION_MAX_AMOUNT=100000000
TRANSACTION_TIMEOUT_MS=30000

# Wallet Service (Double-Entry Ledger)
WALLET_LEDGER_ENABLED=true
WALLET_RECONCILIATION_ENABLED=true
WALLET_MIN_BALANCE=10000

# Investment Service
INVESTMENT_MUTUAL_FUND_ENABLED=false
INVESTMENT_GOLD_TRADING_ENABLED=false
INVESTMENT_ROBO_ADVISOR_ENABLED=false

# KYC Service
KYC_OCR_ENABLED=true
KYC_LIVENESS_ENABLED=true
KYC_DUKCAPIL_INTEGRATION=true
KYC_MAX_UPLOAD_SIZE_MB=5

# Analytics Service
ANALYTICS_FRAUD_SCORING_ENABLED=true
ANALYTICS_ML_MODEL_VERSION=1.0.0
ANALYTICS_RETENTION_DAYS=365

# Notification Service
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false
NOTIFICATION_PUSH_ENABLED=true

# Gateway Service
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MINUTE=100
GATEWAY_CIRCUIT_BREAKER_ENABLED=true
GATEWAY_TIMEOUT_MS=30000

# Billing Service
BILLING_PLN_ENABLED=true
BILLING_PDAM_ENABLED=true
BILLING_MOBILE_POSTPAID_ENABLED=true

# ============================================================================
# THIRD-PARTY API CREDENTIALS (Production Only)
# ============================================================================

# Payment Gateway (Midtrans/Xendit equivalent)
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# SMS Gateway (Twilio/Nexmo equivalent)
SMS_GATEWAY_URL=https://api.sms-gateway.com
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
SMS_GATEWAY_API_SECRET=your_sms_gateway_secret

# Email Service (SendGrid/AWS SES equivalent)
EMAIL_SERVICE_URL=https://api.email-service.com
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@payu.fajjjar.my.id

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ============================================================================
# COMPLIANCE AND AUDIT (OJK/BI Regulations)
# ============================================================================

# Data retention policies (days)
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years (OJK requirement)
TRANSACTION_RETENTION_DAYS=2555
CUSTOMER_DATA_RETENTION_DAYS=2555

# AML (Anti-Money Laundering)
AML_SCREENING_ENABLED=true
AML_TRANSACTION_THRESHOLD=10000000
AML_HIGH_RISK_COUNTRIES=IR,KP,MM

# PII (Personally Identifiable Information) Protection
PII_ENCRYPTION_ENABLED=true
PII_MASKING_ENABLED=true
PII_LOG_LEVEL=none  # Don't log PII

# ============================================================================
# DISASTER RECOVERY AND BACKUP
# ============================================================================

# Database backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=90
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# High availability
HA_ENABLED=false  # Enable in production with multiple replicas
HA_REPLICAS=3
HA_READINESS_TIMEOUT=30
HA_LIVENESS_TIMEOUT=30

# ============================================================================
# PODMAN CONTAINER RUNTIME
# ============================================================================

# Podman Registry Configuration
PODMAN_REGISTRY=registry.payu.internal
PODMAN_REGISTRY_USERNAME=payu
PODMAN_REGISTRY_PASSWORD=your_secure_podman_registry_password

# Build Configuration
BUILDAH_LAYERS=1
PODMAN_BUILDKIT=1
BUILDAH_FORMAT=docker
BUILDAH_ISOLATION=chroot

# Container Storage
CONTAINERS_STORAGE_DIR=/var/lib/containers/storage
CONTAINERS_CONF=/etc/containers/containers.conf

# Podman System Settings
PODMAN_DRIVER=overlay
PODMAN_NETWORK_PREFIX=payu
PODMAN_STORAGE_OPTS=overlay.size=10G

# Remote Podman Configuration
PODMAN_REMOTE_SOCKET=/run/podman/podman.sock
PODMAN_REMOTE_HOST=localhost
PODMAN_REMOTE_PORT=8888

# Security Settings
PODMAN_SECURITY_LEVEL=standard
PODMAN_SIGNATURE_POLICY=/etc/containers/policy.json
PODMAN_TLS_VERIFY=false

# Logging Configuration
PODMAN_LOG_DRIVER=journald
PODMAN_LOG_LEVEL=info
PODMAN_LOG_SIZE=10MB
PODMAN_LOG_MAX_FILES=5

# Volume Settings
PODMAN_VOLUME_DRIVER=local
PODMAN_VOLUME_SIZE=100G
PODMAN_MOUNT_OPTIONS=rw,noexec,nodev,nosuid

# CNI Plugin Configuration
PODMAN_CNI_PLUGIN=bridge
PODMAN_CNI_NETWORK=payu-net
PODMAN_CNI_MTU=1500
PODMAN_CNI_SUBNET=10.88.0.0/16

# Timeout Settings
PODMAN_TIMEOUT_START=30
PODMAN_TIMEOUT_STOP=10
PODMAN_TIMEOUT_BUILD=600
PODMAN_TIMEOUT_PULL=300

# Memory and CPU Limits
PODMAN_MEMORY_LIMIT=4G
PODMAN_CPU_LIMIT=2.0
PODMAN_SWAP_LIMIT=8G
PODMAN_IO_LIMIT=1G

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Connection pools
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=30
DB_IDLE_TIMEOUT=10

# Cache settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=10000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# ============================================================================
# MONITORING ALERTS
# ============================================================================

# AlertManager
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_ENABLED=true

# PagerDuty/OpsGenie integration (for production)
PAGERDUTY_ENABLED=false
PAGERDUTY_API_KEY=your_pagerduty_api_key

# Slack alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_ALERT_CHANNEL=#payu-alerts
