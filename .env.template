# PayU Digital Banking - Environment Variables Template
# Copy this file to .env and update with your values
# NEVER commit .env to version control!
#
# Security Notice: This template contains DEFAULT values for development/testing only.
# For production, replace all default values with strong, unique credentials.

# ============================================
# DATABASE CREDENTIALS
# ============================================

# PostgreSQL - Development/Testing
# REQUIRED: Set in .env file
POSTGRES_USER=${POSTGRES_USER:-payu}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-payu_secret}
POSTGRES_DB=${POSTGRES_DB:-payu_account}

# PostgreSQL - Test Environment
# REQUIRED: Set in .env file
TEST_POSTGRES_USER=${TEST_POSTGRES_USER:-payu_test}
TEST_POSTGRES_PASSWORD=${TEST_POSTGRES_PASSWORD:-test_secret}
TEST_POSTGRES_DB=${TEST_POSTGRES_DB:-payu_test_account}

# TimescaleDB (Analytics)
# REQUIRED: Set in .env file
TIMESCALE_PASSWORD=${TIMESCALE_PASSWORD:-payu_secret}
TEST_TIMESCALE_PASSWORD=${TEST_TIMESCALE_PASSWORD:-test_secret}

# ============================================
# IDENTITY & ACCESS MANAGEMENT
# ============================================

# Keycloak Admin Credentials
# REQUIRED: Set in .env file
KEYCLOAK_ADMIN=${KEYCLOAK_ADMIN:-admin}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-admin}

# Keycloak Database Credentials
# REQUIRED: Set in .env file
KEYCLOAK_DB_PASSWORD=${KEYCLOAK_DB_PASSWORD:-payu_secret}
TEST_KEYCLOAK_DB_PASSWORD=${TEST_KEYCLOAK_DB_PASSWORD:-test_secret}

# Keycloak Client Secret
# REQUIRED: Set in .env file
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET:-secret}
TEST_KEYCLOAK_CLIENT_SECRET=${TEST_KEYCLOAK_CLIENT_SECRET:-test_secret}

# ============================================
# SECRETS MANAGEMENT
# ============================================

# HashiCorp Vault (Development Mode)
# REQUIRED: Set in .env file
VAULT_DEV_ROOT_TOKEN_ID=${VAULT_DEV_ROOT_TOKEN_ID:-dev-only-token}
# WARNING: This token is for development only. Never use in production!

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Grafana Admin Credentials
# REQUIRED: Set in .env file
GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}

# ============================================
# SECURITY REMINDERS
# ============================================
#
# 1. NEVER commit .env to version control
# 2. Use strong, unique passwords for production
# 3. Rotate credentials regularly
# 4. Use different passwords for different environments
# 5. Store production secrets in HashiCorp Vault or similar
# 6. Default values are for LOCAL DEVELOPMENT ONLY
#
# ============================================
# QUICK SETUP INSTRUCTIONS
# ============================================
#
# 1. Copy this template: cp .env.template .env
# 2. Update all password values with secure credentials
# 3. Run: docker-compose up -d
#
# For production deployment:
# - Use HashiCorp Vault for secret management
# - Enable TLS/SSL for all services
# - Use strong password policies (min 16 chars, mixed case, numbers, symbols)
# - Enable audit logging for all credential access
