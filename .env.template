# PayU Digital Banking - Environment Variables Template
# Copy this file to .env and update with your values
# NEVER commit .env to version control!
#
# Security Notice: ALL values marked REQUIRED must be set before starting services.
# For production, use HashiCorp Vault or OpenShift Secrets — never use this file.
# ⚠️  Replace ALL placeholder values before starting services!

# ============================================
# DATABASE CREDENTIALS
# ============================================

# PostgreSQL - Development/Testing
# REQUIRED: Set strong passwords before use
POSTGRES_USER=payu
POSTGRES_PASSWORD=        # REQUIRED — e.g. $(openssl rand -base64 24)
POSTGRES_DB=payu_account

# PostgreSQL - Test Environment
# REQUIRED: Set different passwords from dev
TEST_POSTGRES_USER=payu_test
TEST_POSTGRES_PASSWORD=   # REQUIRED — e.g. $(openssl rand -base64 24)
TEST_POSTGRES_DB=payu_test_account

# TimescaleDB (Analytics)
TIMESCALE_PASSWORD=       # REQUIRED
TEST_TIMESCALE_PASSWORD=  # REQUIRED

# ============================================
# IDENTITY & ACCESS MANAGEMENT
# ============================================

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=  # REQUIRED — strong password

# Keycloak Database Credentials
KEYCLOAK_DB_PASSWORD=     # REQUIRED
TEST_KEYCLOAK_DB_PASSWORD= # REQUIRED

# Keycloak Client Secrets
KEYCLOAK_CLIENT_SECRET=   # REQUIRED — generate with: openssl rand -hex 32
KEYCLOAK_WEB_CLIENT_SECRET= # REQUIRED
KEYCLOAK_BACKEND_CLIENT_SECRET= # REQUIRED
KEYCLOAK_MOBILE_CLIENT_SECRET= # REQUIRED
KEYCLOAK_TEST_USER_PASSWORD= # REQUIRED — password for test users in realm

# ============================================
# SECRETS MANAGEMENT
# ============================================

# HashiCorp Vault
VAULT_DEV_ROOT_TOKEN_ID=  # REQUIRED — generate with: openssl rand -hex 16
# WARNING: dev-only-token must NEVER be used in staging/production!

# ============================================
# SECURITY — JWT & Signing Keys
# ============================================

# JWT Signing Secret (base64 encoded, min 256-bit)
JWT_SECRET=               # REQUIRED — generate with: openssl rand -base64 48
SECRET_KEY=               # REQUIRED — for Python services (KYC, Analytics)
OIDC_CLIENT_SECRET=       # REQUIRED — Keycloak OIDC client secret for gateway
WEBHOOK_PARTNER_1_SECRET= # REQUIRED — HMAC secret for webhook verification

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=   # REQUIRED — strong password

# ============================================
# SECURITY REMINDERS
# ============================================
#
# 1. NEVER commit .env to version control
# 2. Use strong, unique passwords (min 16 chars, mixed case, numbers, symbols)
# 3. Rotate credentials regularly
# 4. Use different passwords for different environments
# 5. Store production secrets in HashiCorp Vault or OpenShift Secrets
#
# ============================================
# QUICK SETUP INSTRUCTIONS
# ============================================
#
# 1. Copy this template: cp .env.template .env
# 2. Generate passwords:
#      export PW=$(openssl rand -base64 24)
#      sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$PW/" .env
#    Repeat for each REQUIRED field
# 3. Run: podman-compose up -d
