{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:automerge"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["pin", "digest"],
      "groupName": "pin-actions"
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "timezone": "Asia/Jakarta"
}
