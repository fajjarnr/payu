---
openapi: 3.1.0
paths:
  /api/v1/admin/rate-plans:
    get:
      summary: List rate plans
      description: "Returns all rate plans, optionally filtered by active status"
      tags:
      - Rate Plans
      parameters:
      - description: Filter by active status only
        name: active
        in: query
        schema:
          type: boolean
          default: true
      responses:
        "200":
          description: Rate plans retrieved successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RatePlan"
      security:
      - bearerAuth: []
    post:
      summary: Create rate plan
      description: Creates a new rate plan with default and endpoint-specific limits
      tags:
      - Rate Plans
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateRatePlanRequest"
        required: true
      responses:
        "201":
          description: Rate plan created successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RatePlan"
        "400":
          description: Invalid request
      security:
      - bearerAuth: []
  /api/v1/admin/rate-plans/assignments:
    post:
      summary: Assign rate plan to partner
      description: Assigns a rate plan to a specific partner
      tags:
      - Rate Plans
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AssignRatePlanRequest"
        required: true
      responses:
        "201":
          description: Rate plan assigned successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PartnerRatePlan"
        "400":
          description: Invalid request
      security:
      - bearerAuth: []
  /api/v1/admin/rate-plans/partners/{partnerId}/limits:
    get:
      summary: Get partner rate limits
      description: Returns the effective rate limits for a partner on a specific endpoint
      tags:
      - Rate Plans
      parameters:
      - description: Partner ID
        required: true
        name: partnerId
        in: path
        schema:
          type: string
      - description: Endpoint path
        name: endpoint
        in: query
        schema:
          type: string
      responses:
        "200":
          description: Rate limits retrieved successfully
          content:
            application/json:
              schema:
                type: object
      security:
      - bearerAuth: []
  /api/v1/admin/rate-plans/partners/{partnerId}/rate-plan:
    get:
      summary: Get partner rate plan
      description: Returns the rate plan assigned to a specific partner
      tags:
      - Rate Plans
      parameters:
      - description: Partner ID
        required: true
        name: partnerId
        in: path
        schema:
          type: string
      responses:
        "200":
          description: Rate plan found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PartnerRatePlan"
        "404":
          description: No rate plan assigned for partner
      security:
      - bearerAuth: []
  /api/v1/admin/rate-plans/partners/{partnerId}/status:
    get:
      summary: Check partner rate limit status
      description: Checks the current rate limit status for a partner on a specific
        endpoint
      tags:
      - Rate Plans
      parameters:
      - description: Partner ID
        required: true
        name: partnerId
        in: path
        schema:
          type: string
      - description: Endpoint path
        name: endpoint
        in: query
        schema:
          type: string
          default: /api/v1/accounts
      responses:
        "200":
          description: Rate limit status retrieved successfully
          content:
            application/json:
              schema:
                type: object
      security:
      - bearerAuth: []
  /api/v1/admin/rate-plans/{id}:
    put:
      summary: Update rate plan
      description: Updates an existing rate plan
      tags:
      - Rate Plans
      parameters:
      - description: Rate plan ID
        required: true
        name: id
        in: path
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateRatePlanRequest"
        required: true
      responses:
        "200":
          description: Rate plan updated successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RatePlan"
        "404":
          description: Rate plan not found
        "400":
          description: Invalid request
      security:
      - bearerAuth: []
    get:
      summary: Get rate plan by ID
      description: Returns a specific rate plan by its ID
      tags:
      - Rate Plans
      parameters:
      - description: Rate plan ID
        required: true
        name: id
        in: path
        schema:
          type: string
      responses:
        "200":
          description: Rate plan found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RatePlan"
        "404":
          description: Rate plan not found
      security:
      - bearerAuth: []
    delete:
      summary: Delete rate plan
      description: Deletes a rate plan by its ID
      tags:
      - Rate Plans
      parameters:
      - description: Rate plan ID
        required: true
        name: id
        in: path
        schema:
          type: string
      responses:
        "204":
          description: Rate plan deleted successfully
        "404":
          description: Rate plan not found
      security:
      - bearerAuth: []
  /api/v1/checkout/page/{token}:
    get:
      parameters:
      - name: token
        in: path
        required: true
        schema:
          type: string
      responses:
        "200":
          description: OK
          content:
            text/html: {}
      summary: Checkout Page
      tags:
      - Checkout Resource
  /api/v1/checkout/tokens:
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateCheckoutRequest"
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema: {}
        "400":
          description: Bad Request
      summary: Create Checkout Token
      tags:
      - Checkout Resource
  /api/v1/checkout/tokens/{token}:
    get:
      parameters:
      - name: token
        in: path
        required: true
        schema:
          type: string
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema: {}
      summary: Get Checkout Session
      tags:
      - Checkout Resource
  /api/v1/checkout/tokens/{token}/pay:
    post:
      parameters:
      - name: token
        in: path
        required: true
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              type: object
              additionalProperties:
                type: string
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema: {}
        "400":
          description: Bad Request
      summary: Complete Checkout
      tags:
      - Checkout Resource
  /api/v1/deeplinks:
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/DeeplinkRequest"
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema: {}
        "400":
          description: Bad Request
      summary: Generate Deeplink
      tags:
      - Deeplink Resource
  /api/v1/payments/methods:
    get:
      summary: Get available payment methods
      description: "Returns available payment methods with eligibility, fees, and\
        \ settlement times based on payment context"
      tags:
      - Payment Methods
      parameters:
      - description: Payment amount
        example: 100000.0
        name: amount
        in: query
        schema:
          type: number
      - description: Currency code (ISO 4217)
        example: IDR
        name: currency
        in: query
        schema:
          type: string
          default: IDR
      - description: KYC status of user
        name: kycStatus
        in: query
        schema:
          type: string
      - description: Partner ID for partner-specific methods
        name: partnerId
        in: query
        schema:
          type: string
      - description: User ID
        name: userId
        in: query
        schema:
          type: string
      responses:
        "200":
          description: Payment methods retrieved successfully
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PaymentMethodInfo"
        "400":
          description: Invalid request parameters
        "401":
          description: Authentication required
