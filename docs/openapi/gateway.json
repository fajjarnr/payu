            application/json:
              schema:
                type: object
components:
  schemas:
    AssignRatePlanRequest:
      type: object
      properties:
        partnerId:
          type: string
        ratePlanId:
          type: string
    CreateCheckoutRequest:
      type: object
      properties:
        partnerId:
          type: string
        orderId:
          type: string
        amount:
          type: number
        currency:
          type: string
        itemName:
          type: string
        customerName:
          type: string
        customerEmail:
          type: string
        callbackUrl:
          type: string
        redirectUrl:
          type: string
    CreateRatePlanRequest:
      type: object
      properties:
        name:
          type: string
        description:
          type: string
        requestsPerMinute:
          type: integer
          format: int32
        requestsPerHour:
          type: integer
          format: int32
        requestsPerDay:
          type: integer
          format: int32
        endpointOverrides:
          type: object
          additionalProperties:
            type: object
            additionalProperties:
              type: integer
              format: int32
    DeeplinkRequest:
      type: object
      properties:
        action:
          type: string
        token:
          type: string
        amount:
          type: string
        orderId:
          type: string
        partnerId:
          type: string
        expiryMinutes:
          type: integer
          format: int32
    Instant:
      type: string
      format: date-time
      examples:
      - 2022-03-10T16:15:50Z
    PartnerRatePlan:
      type: object
      properties:
        id:
          type: string
        partnerId:
          type: string
        ratePlanId:
          type: string
        assignedAt:
          $ref: "#/components/schemas/Instant"
        effectiveFrom:
          $ref: "#/components/schemas/Instant"
        effectiveUntil:
          $ref: "#/components/schemas/Instant"
        active:
          type: boolean
        effectiveNow:
          type: boolean
    PaymentMethodInfo:
      type: object
      properties:
        code:
          type: string
        name:
          type: string
        category:
          type: string
        eligible:
          type: boolean
        fee:
          type: number
        feeCurrency:
          type: string
        estimatedSettlementTime:
          type: string
        description:
          type: string
        metadata:
          type: object
          additionalProperties:
            type: string
    RateLimit:
      type: object
      properties:
        requestsPerMinute:
          type: integer
          format: int32
        requestsPerHour:
          type: integer
          format: int32
        requestsPerDay:
          type: integer
          format: int32
    RatePlan:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        description:
