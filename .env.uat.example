# PayU Digital Banking - UAT Environment Variables Template
# ============================================================================
# Copy this file to .env and configure for UAT environment.
# Integrates with sandbox/staging partner APIs (NOT simulators).
# ============================================================================

# Build Metadata
BUILD_DATE=2026-07-02T00:00:00Z
GIT_COMMIT=uat-commit-sha
VERSION=1.8.71-uat

# Application Settings
APP_ENV=uat
APP_DEBUG=false
LOG_LEVEL=info
TZ=Asia/Jakarta

# Database - PostgreSQL (UAT Settings)
POSTGRES_HOST=payu-postgres-uat.payu-db-uat.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=payu_uat_app
POSTGRES_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
POSTGRES_DB=payu_uat
POSTGRES_SSL_MODE=verify-full

# TimescaleDB (Analytics Service - UAT)
TIMESCALE_HOST=payu-timescale-uat.payu-db-uat.svc.cluster.local
TIMESCALE_PORT=5433
TIMESCALE_USER=payu_analytics_uat_app
TIMESCALE_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
TIMESCALE_DB=payu_analytics_uat
TIMESCALE_SSL_MODE=verify-full

# Cache - Redis (UAT Settings)
REDIS_HOST=payu-redis-uat.payu-cache-uat.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
REDIS_DB=0
REDIS_SSL=true

# Message Broker - Kafka (UAT Settings)
KAFKA_BOOTSTRAP_SERVERS=payu-kafka-uat-kafka-bootstrap.payu-messaging-uat.svc.cluster.local:9092
KAFKA_GROUP_ID=payu-services-uat
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=payu-client-uat
KAFKA_SASL_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT

# Secrets - HashiCorp Vault (UAT Settings)
VAULT_ADDR=https://vault-uat.payu-security-uat.svc.cluster.local:8200
VAULT_ROLE=payu-service-role-uat
VAULT_AUTH_METHOD=kubernetes

# External Sandbox/Staging Partner APIs (Real Sandbox)
BIFAST_API_URL=https://api-sandbox.bifast.or.id/v1
BIFAST_CLIENT_ID=REQUIRED_UAT_SANDBOX_CLIENT_ID
BIFAST_CLIENT_SECRET=REQUIRED_UAT_SANDBOX_SECRET
BIFAST_TIMEOUT=20000

DUKCAPIL_API_URL=https://api-sandbox.dukcapil.kemendagri.go.id/v1
DUKCAPIL_API_KEY=REQUIRED_UAT_SANDBOX_API_KEY
DUKCAPIL_TIMEOUT=15000

QRIS_API_URL=https://api-sandbox.qris-processor.co.id/v1
QRIS_MERCHANT_ID=REQUIRED_UAT_SANDBOX_MERCHANT_ID
QRIS_CLIENT_ID=REQUIRED_UAT_SANDBOX_CLIENT_ID
QRIS_CLIENT_SECRET=REQUIRED_UAT_SANDBOX_SECRET
QRIS_TIMEOUT=20000

# Observability - OpenTelemetry (UAT Settings)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-uat.payu-monitoring-uat.svc.cluster.local:4317
OTEL_SERVICE_NAME=payu-core-service-uat
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.5  # Sample 50% of traces in UAT

# Feature Flags
FEATURE_BIFAST_ENABLED=true
FEATURE_QRIS_ENABLED=true
FEATURE_VIRTUAL_CARDS_ENABLED=true
FEATURE_INVESTMENT_ENABLED=true
FEATURE_LENDING_ENABLED=true
FEATURE_FX_TRADING_ENABLED=true
FEATURE_EXPERIMENTAL_UI_ENABLED=false  # Disable experimental UI for business testing
FEATURE_BETA_ANALYTICS_ENABLED=false
