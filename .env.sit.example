# PayU Digital Banking - SIT Environment Variables Template
# ============================================================================
# Copy this file to .env and configure for SIT environment.
# ============================================================================

# Build Metadata
BUILD_DATE=2026-07-02T00:00:00Z
GIT_COMMIT=sit-commit-sha
VERSION=1.8.71-sit

# Application Settings
APP_ENV=sit
APP_DEBUG=false
LOG_LEVEL=info
TZ=Asia/Jakarta

# Database - PostgreSQL (SIT Settings)
POSTGRES_HOST=payu-postgres-sit.payu-db-sit.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=payu_sit_app
POSTGRES_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
POSTGRES_DB=payu_sit
POSTGRES_SSL_MODE=verify-full

# TimescaleDB (Analytics Service - SIT)
TIMESCALE_HOST=payu-timescale-sit.payu-db-sit.svc.cluster.local
TIMESCALE_PORT=5433
TIMESCALE_USER=payu_analytics_sit_app
TIMESCALE_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
TIMESCALE_DB=payu_analytics_sit
TIMESCALE_SSL_MODE=verify-full

# Cache - Redis (SIT Settings)
REDIS_HOST=payu-redis-sit.payu-cache-sit.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
REDIS_DB=0
REDIS_SSL=true

# Message Broker - Kafka (SIT Settings)
KAFKA_BOOTSTRAP_SERVERS=payu-kafka-sit-kafka-bootstrap.payu-messaging-sit.svc.cluster.local:9092
KAFKA_GROUP_ID=payu-services-sit
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=payu-client-sit
KAFKA_SASL_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT

# Secrets - HashiCorp Vault (SIT Settings)
VAULT_ADDR=https://vault-sit.payu-security-sit.svc.cluster.local:8200
VAULT_ROLE=payu-service-role-sit
VAULT_AUTH_METHOD=kubernetes

# External Services Simulators (SIT usually uses Simulators for isolated testing)
BIFAST_API_URL=http://payu-bifast-simulator.payu-sit.svc:8090
BIFAST_CLIENT_ID=payu_sit_test
BIFAST_CLIENT_SECRET=bifast_sit_test_secret
BIFAST_TIMEOUT=20000

DUKCAPIL_API_URL=http://payu-dukcapil-simulator.payu-sit.svc:8091
DUKCAPIL_API_KEY=dukcapil_sit_test_key
DUKCAPIL_TIMEOUT=15000

QRIS_API_URL=http://payu-qris-simulator.payu-sit.svc:8092
QRIS_MERCHANT_ID=1234567890
QRIS_CLIENT_ID=payu_qris_sit
QRIS_CLIENT_SECRET=qris_sit_test_secret
QRIS_TIMEOUT=20000

# Observability - OpenTelemetry (SIT Settings)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-sit.payu-monitoring-sit.svc.cluster.local:4317
OTEL_SERVICE_NAME=payu-core-service-sit
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0  # Trace everything in SIT for debugging

# Feature Flags
FEATURE_BIFAST_ENABLED=true
FEATURE_QRIS_ENABLED=true
FEATURE_VIRTUAL_CARDS_ENABLED=true
FEATURE_INVESTMENT_ENABLED=true
FEATURE_LENDING_ENABLED=true
FEATURE_FX_TRADING_ENABLED=true
FEATURE_EXPERIMENTAL_UI_ENABLED=true
FEATURE_BETA_ANALYTICS_ENABLED=true
