<?xml version="1.0" encoding="UTF-8"?>
<!--
    PayU Standard Logging Configuration for transaction-service
    Uses shared logback-payu-base.xml for consistent logging across services
-->
<configuration>
    <include resource="logback-payu-base.xml"/>

    <!-- Service-specific: transaction domain debug logging in dev -->
    <springProfile name="default,dev,test">
        <logger name="id.payu.transaction" level="DEBUG"/>
    </springProfile>

    <springProfile name="staging,prod,container">
        <logger name="id.payu.transaction" level="INFO"/>
    </springProfile>
</configuration>
