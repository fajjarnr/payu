{
  "realm": "payu",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "offlineSessionIdleTimeout": 2592000,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard PayU user"
      },
      {
        "name": "admin",
        "description": "PayU administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "auth-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-client-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "webOrigins": ["*"],
      "redirectUris": ["*"],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "payu-mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "webOrigins": ["*"],
      "redirectUris": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "DPoPBound": "true",
        "oauth2.device.authorization.grant.enabled": "true"
      }
    },
    {
      "clientId": "payu-web-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "webOrigins": ["https://payu.co.id", "*"],
      "redirectUris": ["https://payu.co.id/api/v1/auth/callback", "*"],
      "attributes": {
        "access.token.lifespan": "300",
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "DPoPBound": "true"
      }
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@payu.fajjjar.my.id",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "TestPass123!",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "adminuser",
      "email": "admin@payu.fajjjar.my.id",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "AdminPass123!",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}
