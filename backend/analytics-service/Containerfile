# ============================================
# Stage 1: Builder
# Red Hat UBI9 Python 3.12 for OpenShift production runtime parity.
# ============================================
FROM registry.access.redhat.com/ubi9/python-312@sha256:f0a3c86eb6ab0ef1a302f3edcc0e15bf2432492fc8a0903acdedae50c1786d2d AS builder
COPY --from=ghcr.io/astral-sh/uv:0.5.20 /uv /usr/local/bin/uv

USER 0
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# Install build dependencies
RUN dnf install -y --setopt=install_weak_deps=False \
    gcc \
    gcc-c++ \
    make \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Copy requirements and install Python dependencies into an explicit target.
COPY requirements.txt ./
RUN uv pip install --target /opt/payu-python --extra-index-url https://download.pytorch.org/whl/cpu --no-cache -r requirements.txt

# Copy application source
COPY src/ /app/src/

# ============================================
# Stage 2: Runtime
# ============================================
FROM registry.access.redhat.com/ubi9/python-312@sha256:f0a3c86eb6ab0ef1a302f3edcc0e15bf2432492fc8a0903acdedae50c1786d2d

# OCI Metadata Labels
ARG APP_VERSION=1.5.0
LABEL maintainer="backend-team@payu.fajjjar.my.id"
LABEL org.opencontainers.image.title="payu-analytics-service"
LABEL org.opencontainers.image.description="PayU Analytics Service - Fraud Scoring, User Insights"
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.source="https://github.com/payu/backend/analytics-service"
LABEL id.payu.service.tier="supporting"

USER 0
WORKDIR /app
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# Install runtime dependencies for ML libraries (OpenCV, etc)
RUN dnf install -y --setopt=install_weak_deps=False \
    glib2 \
    libgomp \
    mesa-libGL \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Copy installed packages from builder
COPY --from=builder /opt/payu-python /opt/payu-python

# Copy application source
COPY --from=builder /app/src /app/src

# Create application directories for OpenShift arbitrary-user compatible group 0.
RUN mkdir -p /app/tmp /app/logs && \
    chown -R 1001:0 /app && \
    chmod -R g=u /app

USER 1001

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV LOG_LEVEL=INFO
ENV PYTHONPATH="/opt/payu-python:/app/src"
ENV SERVICE_NAME=analytics-service
ENV SERVICE_VERSION=${APP_VERSION}
ENV ENVIRONMENT=container



WORKDIR /app/src

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "4"]
