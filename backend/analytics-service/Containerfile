# ============================================
# Stage 1: Builder
# python:3.12-slim (Debian) — better ML/AI lib compatibility
# (UBI9 has known issues with OpenCV, PaddleOCR, PyTorch wheels)
# ============================================
FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.5.20 /uv /uv

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt ./
ENV UV_COMPILE_BYTECODE=1
RUN /uv pip install --system --no-cache -r requirements.txt

# Copy application source
COPY src/ /app/src/

# ============================================
# Stage 2: Runtime
# ============================================
FROM python:3.12-slim

# OCI Metadata Labels
LABEL maintainer="backend-team@payu.fajjjar.my.id"
LABEL org.opencontainers.image.title="payu-analytics-service"
LABEL org.opencontainers.image.description="PayU Analytics Service - Fraud Scoring, User Insights"
LABEL org.opencontainers.image.version="1.5.0"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.source="https://github.com/payu/backend/analytics-service"
LABEL id.payu.service.tier="supporting"

WORKDIR /app

# Install runtime dependencies for ML libraries (OpenCV, etc)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Fix setuptools version to avoid compatibility issues
RUN pip install 'setuptools<81'

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY --from=builder /app/src /app/src

# Create user and directories
RUN useradd -m -u 1001 appuser && \
    mkdir -p /app/tmp /app/logs && \
    chown -R appuser:appuser /app

USER 1001

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV LOG_LEVEL=INFO
ENV PYTHONPATH="/app/src"
ENV SERVICE_NAME=analytics-service
ENV SERVICE_VERSION=1.0.0
ENV ENVIRONMENT=container



WORKDIR /app/src

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "4"]
