<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="pricing"
             name="Pricing"
             namespace="http://payu.id/dmn">
  <description>Pricing decision table — HALF_EVEN money rounding for interest amounts. Minimal valid DMN 1.3 with one rule (GAP-015/048).</description>
  <decision id="Pricing" name="Pricing">
    <variable name="PricingOutput" typeRef="feel:context"/>
    <informationRequirement>
      <requiredInput href="#creditScore"/>
    </informationRequirement>
    <decisionTable id="PricingTable" hitPolicy="UNIQUE" preferredOrientation="Rule-as-Row">
      <input id="inputCreditScore" label="Credit Score">
        <inputExpression id="inputExpr1" typeRef="number">
          <text>creditScore</text>
        </inputExpression>
      </input>
      <output id="outputInterestRate" label="Interest Rate" name="interestRate" typeRef="number"/>
      <output id="outputRiskCategory" label="Risk Category" name="riskCategory" typeRef="string"/>
      <rule id="r1">
        <description>Default tier — money values rounded HALF_EVEN (e.g. round half even(amount*rate,2))</description>
        <inputEntry id="r1c1"><text>-</text></inputEntry>
        <outputEntry id="r1o1"><text>0.12</text></outputEntry>
        <outputEntry id="r1o2"><text>"EXCELLENT"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="creditScore" name="creditScore">
    <variable name="creditScore" typeRef="number"/>
  </inputData>
</definitions>
