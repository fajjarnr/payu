{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payu.id/schemas/auth-register.json",
  "title": "Register Request",
  "description": "Schema for user registration requests",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "pattern": "^[a-zA-Z0-9_]+$"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 255
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "phoneNumber": {
      "type": "string",
      "pattern": "^\\+?[0-9]{10,15}$"
    }
  },
  "required": ["username", "email", "password", "fullName"],
  "additionalProperties": false
}
