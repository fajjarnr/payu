{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payu.id/schemas/payments-create.json",
  "title": "Create Payment Request",
  "description": "Schema for bill payment requests (matches billing-service CreatePaymentRequest DTO)",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "minLength": 1,
      "description": "Source account identifier"
    },
    "billerCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Biller code (e.g., PLN, PDAM)"
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Customer number at the biller"
    },
    "amount": {
      "type": ["number", "string"],
      "exclusiveMinimum": 0,
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$",
      "description": "Payment amount (strings must be canonical decimal, max 4dp)"
    }
  },
  "required": ["accountId", "billerCode", "customerId", "amount"],
  "additionalProperties": false
}
