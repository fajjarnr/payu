{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payu.id/schemas/transactions-transfer.json",
  "title": "Transfer Request",
  "description": "Schema for fund transfer requests (matches InitiateTransferRequest DTO)",
  "type": "object",
  "properties": {
    "senderAccountId": {
      "type": "string",
      "minLength": 1,
      "description": "Sender account UUID"
    },
    "recipientAccountNumber": {
      "type": "string",
      "minLength": 10,
      "maxLength": 20,
      "pattern": "^[0-9]+$",
      "description": "Recipient account number (10-20 digits)"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Transfer amount (must be positive)"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "IDR"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Transfer description (required)"
    },
    "type": {
      "type": "string",
      "enum": ["INTERNAL_TRANSFER", "BIFAST_TRANSFER", "SKN_TRANSFER", "RTGS_TRANSFER", "QRIS_PAYMENT", "BILL_PAYMENT", "TOP_UP"],
      "description": "Transaction type"
    },
    "transactionPin": {
      "type": "string",
      "pattern": "^[0-9]{6}$",
      "description": "6-digit transaction PIN"
    },
    "deviceId": {
      "type": "string",
      "description": "Device identifier"
    },
    "idempotencyKey": {
      "type": "string",
      "description": "Idempotency key for duplicate prevention"
    },
    "memo": {
      "type": "string",
      "maxLength": 140,
      "description": "Optional memo"
    }
  },
  "required": ["senderAccountId", "recipientAccountNumber", "amount", "description"],
  "additionalProperties": false
}
