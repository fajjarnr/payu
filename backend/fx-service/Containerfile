# =============================================================================
# PayU fx-service - Multi-stage Container Build
# =============================================================================
# Stage 1: Build
# =============================================================================
FROM registry.access.redhat.com/ubi9/openjdk-25:1.24 AS builder

WORKDIR /build
COPY pom.xml .
# Strip <modules> so Maven only discovers what is actually copied
RUN sed '/<\(modules\)>/,/<\/\(modules\)>/d' pom.xml > /tmp/pom.xml && mv /tmp/pom.xml pom.xml
COPY fx-service/pom.xml fx-service/
COPY shared/ shared/

RUN mvn -f pom.xml dependency:go-offline -pl fx-service -am -B

COPY fx-service/src fx-service/src
RUN mvn -f pom.xml clean package -DskipTests -pl fx-service -am -B

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24

ARG APP_VERSION=1.8.1

LABEL maintainer="backend-team@payu.fajjjar.my.id"
LABEL org.opencontainers.image.title="payu-fx-service"
LABEL org.opencontainers.image.description="PayU fx-service"
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.source="https://github.com/payu/backend/fx-service"
LABEL id.payu.service.tier="core"

USER 185
WORKDIR /deployments

COPY --from=builder --chown=185 /build/fx-service/target/*.jar /deployments/app.jar

EXPOSE 8080

ENV SPRING_APPLICATION_NAME=fx-service
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/deployments/heapdump.hprof \
    -Djava.security.egd=file:/dev/./urandom"

HEALTHCHECK --interval=30s --timeout=3s --start-period=90s --retries=3 \
    CMD curl -sf http://localhost:8080/actuator/health/liveness || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /deployments/app.jar"]
