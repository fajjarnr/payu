####
# Runtime-only Containerfile - Using pre-built JAR
####
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24-2

# Metadata labels
LABEL maintainer="backend-team@payu.fajjjar.my.id"
LABEL description="PayU Partner Service - SNAP BI Standard & Merchant Integration"
LABEL version="1.5.0"
LABEL org.opencontainers.image.title="payu-partner-service"
LABEL org.opencontainers.image.description="PayU Partner Service - SNAP BI standard API integration and merchant management"
LABEL org.opencontainers.image.version="1.5.0"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.url="https://payu.fajjjar.my.id"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.authors="PayU Backend Team"
LABEL id.payu.service.tier="core"
LABEL id.payu.compliance.pci-dss="required"
LABEL id.payu.security.scan-level="high"

# Use non-root user (185 is the default jboss user in UBI images)
USER 185

WORKDIR /deployments

# Copy the pre-built Spring Boot JAR
COPY --chown=185 target/partner-service-1.0.0-SNAPSHOT.jar /deployments/app.jar

# Volume mounts for temporary files and logs
VOLUME ["/deployments/tmp", "/deployments/logs"]

# Expose the service port
EXPOSE 8080

# JVM configuration for containers
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=100 \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/deployments/heapdump.hprof \
    -Djava.security.egd=file:/dev/./urandom"

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /deployments/app.jar"]
