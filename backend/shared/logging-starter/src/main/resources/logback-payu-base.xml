<?xml version="1.0" encoding="UTF-8"?>
<!--
    PayU Standard Logging Configuration
    Include this in your service's logback-spring.xml:
    <include resource="logback-payu-base.xml"/>

    Features:
    - JSON logging via LogstashEncoder for production
    - MDC support for correlation_id, trace_id, span_id
    - Service metadata (service name, version, environment)
    - LokiStack compatible format
-->
<configuration>
    <!-- Import Spring Boot defaults -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Spring Boot property support -->
    <springProperty scope="context" name="SERVICE_NAME" source="payu.logging.service-name" defaultValue="${spring.application.name:-unknown-service}"/>
    <springProperty scope="context" name="SERVICE_VERSION" source="payu.logging.service-version" defaultValue="1.0.0"/>
    <springProperty scope="context" name="ENVIRONMENT" source="payu.logging.environment" defaultValue="dev"/>
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <!-- Console Appender with JSON for production -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include all standard fields -->
            <includeContext>true</includeContext>
            <includeMdc>true</includeMdc>
            <includeStructuredArguments>true</includeStructuredArguments>

            <!-- Custom fields for PayU standard -->
            <customFields>{"service":"${SERVICE_NAME}","service_version":"${SERVICE_VERSION}","environment":"${ENVIRONMENT}"}</customFields>

            <!-- Field names compatible with Loki -->
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Console Appender with plain text for development -->
    <appender name="TEXT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlation_id:-}] [%X{trace_id:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Async Appender for production performance -->
    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_CONSOLE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- Profile-based configuration -->
    <springProfile name="default,dev,test">
        <root level="${LOG_LEVEL}">
            <appender-ref ref="TEXT_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="staging,prod,container">
        <root level="${LOG_LEVEL}">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>

    <!--
        Fallback: if no profile matches (e.g. custom profile), still log to console.
        Without this, mismatched profiles cause silent log loss.
    -->
    <springProfile name="!default &amp; !dev &amp; !test &amp; !staging &amp; !prod &amp; !container">
        <root level="${LOG_LEVEL}">
            <appender-ref ref="TEXT_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Reduce noise from third-party libraries -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="io.micrometer" level="WARN"/>
</configuration>
