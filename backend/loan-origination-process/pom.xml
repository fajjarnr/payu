<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>id.payu</groupId>
        <artifactId>payu-backend-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>id.payu</groupId>
    <artifactId>loan-origination-process</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>loan-origination-process</name>
    <description>Loan Origination BPMN Process Orchestration — multi-step approval via jBPM/Drools</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- jBPM + Drools Process Engine (includes BPMN, WorkItem, UserTask, Drools) -->
        <dependency>
            <groupId>org.jbpm</groupId>
            <artifactId>jbpm-with-drools-spring-boot-starter</artifactId>
            <version>${kie.version}</version>
        </dependency>

        <!-- KIE Process Management REST API (process instance queries) -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-springboot-process-management</artifactId>
            <version>${kie.version}</version>
        </dependency>

        <!-- KIE JDBC Persistence (PostgreSQL) -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-springboot-persistence-jdbc</artifactId>
            <version>${kie.version}</version>
        </dependency>

        <!-- PostgreSQL driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- JPA API for Drools transitive dep -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- REST client for calling lending-rules service -->
        <dependency>
            <groupId>id.payu</groupId>
            <artifactId>rest-client-starter</artifactId>
        </dependency>

        <!-- Outbox for event publishing -->
        <dependency>
            <groupId>id.payu</groupId>
            <artifactId>outbox-starter</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
