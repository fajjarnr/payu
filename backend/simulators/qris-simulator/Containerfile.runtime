####
# Runtime-only Containerfile - Using pre-built Quarkus JAR
####
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24-2

# Metadata labels
LABEL maintainer="backend-team@payu.id"
LABEL description="PayU QRIS Simulator - QR Code Payment Simulation"
LABEL version="1.0.0"
LABEL org.opencontainers.image.title="payu-qris-simulator"
LABEL org.opencontainers.image.description="PayU QRIS Simulator - Simulates QRIS QR code payment operations for testing"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.url="https://payu.id"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.authors="PayU Backend Team"
LABEL id.payu.service="qris-simulator"
LABEL id.payu.tier="simulator"
LABEL id.payu.runtime="quarkus"

# Use non-root user (185 is the default jboss user in UBI images)
USER 185

WORKDIR /deployments

# Copy Quarkus fast-jar structure for better layer caching
COPY --chown=185 simulators/qris-simulator/target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 simulators/qris-simulator/target/quarkus-app/*.jar /deployments/
COPY --chown=185 simulators/qris-simulator/target/quarkus-app/app/ /deployments/app/
COPY --chown=185 simulators/qris-simulator/target/quarkus-app/quarkus/ /deployments/quarkus/

# Volume mounts for temporary files and logs
VOLUME ["/deployments/tmp", "/deployments/logs"]

# Expose the service port
EXPOSE 8092

# JVM configuration
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=100 \
    -Dquarkus.http.host=0.0.0.0 \
    -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

# Run the Quarkus application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /deployments/quarkus-run.jar"]
