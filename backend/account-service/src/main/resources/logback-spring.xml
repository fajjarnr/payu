<?xml version="1.0" encoding="UTF-8"?>
<!--
    PayU Standard Logging Configuration for account-service
    Includes audit logging for security events
-->
<configuration>
    <include resource="logback-payu-base.xml"/>

    <!-- Audit Logger for Security Events (account-service specific) -->
    <springProfile name="prod">
        <appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/payu/audit.log</file>
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %logger{36} | %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>/var/log/payu/audit-%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>365</maxHistory>
            </rollingPolicy>
        </appender>

        <logger name="id.payu.security" level="INFO" additivity="false">
            <appender-ref ref="AUDIT"/>
            <appender-ref ref="JSON_CONSOLE"/>
        </logger>
    </springProfile>

    <springProfile name="!prod">
        <logger name="id.payu.security" level="INFO" additivity="false">
            <appender-ref ref="TEXT_CONSOLE"/>
        </logger>
    </springProfile>
</configuration>
