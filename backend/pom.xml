<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>id.payu</groupId>
    <artifactId>payu-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PayU Backend Parent</name>
    <description>Parent POM for PayU Digital Banking Platform Backend Services</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Security Patches (RHACS Compliance) -->
        <!-- Jackson 2 versions are managed by SB 4.1.0's jackson-2-bom (currently 2.21.4 + annotations 2.21 which provides JsonSerializeAs required by Jackson 3 BOM). Do NOT pin <jackson.version> here unless you also bump the SB parent BOM. -->
        <commons-io.version>2.18.0</commons-io.version>
        <commons-fileupload.version>1.6.0</commons-fileupload.version>
        <postgresql.version>42.7.12</postgresql.version>

        <!-- PayU Shared Modules Versions -->
        <payu.shared.version>1.0.0-SNAPSHOT</payu.shared.version>

        <!-- Third-party Versions -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <cloudevents.version>4.0.1</cloudevents.version>
        <hypersistence.version>3.15.3</hypersistence.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <shedlock.version>5.16.0</shedlock.version>
        <spring-cloud-contract.version>4.3.4</spring-cloud-contract.version>
        <springdoc.version>3.0.3</springdoc.version>
        <archunit.version>1.4.2</archunit.version>
        <swagger-annotations.version>2.2.25</swagger-annotations.version>
        <lombok.version>1.18.42</lombok.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <drools.version>8.44.0.Final</drools.version>
        <kie.version>10.2.0</kie.version>
    </properties>

    <modules>
        <!-- Shared Libraries - Build First (No inter-dependencies) -->
        <module>shared/api-commons</module>
        <module>shared/events-starter</module>
        <module>shared/security-starter</module>
        <module>shared/resilience-starter</module>
        <module>shared/cache-starter</module>
        <module>shared/logging-starter</module>
        <module>shared/outbox-starter</module>
        <module>shared/saga-starter</module>
        <module>shared/archunit-starter</module>
        <module>shared/grpc-starter</module>
        <module>shared/rest-client-starter</module>
        <module>shared/quarkus-api-commons</module>
        <module>shared/jms-starter</module>
        <module>shared/rules-starter</module>
        <module>shared/datasource-starter</module>

        <!-- Simulators -->
        <module>simulators/bi-fast-simulator</module>
        <module>simulators/biller-simulator</module>
        <module>simulators/dukcapil-simulator</module>
        <module>simulators/qris-simulator</module>
        <module>simulators/va-simulator</module>

        <!-- Core Services -->
        <module>account-service</module>
        <module>auth-service</module>
        <module>product-catalog-service</module>
        <module>wallet-service</module>
        <module>transaction-service</module>
        <module>investment-service</module>
        <module>lending-service</module>
        <module>loan-origination-process</module>
        <module>statement-service</module>
        <module>billing-service</module>
        <module>notification-service</module>
        <module>gateway-service</module>
        <module>backoffice-service</module>
        <module>partner-service</module>
        <module>promotion-service</module>
        <module>support-service</module>
        <module>compliance-service</module>
        <module>fx-service</module>
        <module>cms-service</module>
        <module>api-portal-service</module>
        <module>dispute-service</module>
        <module>integration-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- PayU Shared Modules -->
            <dependency>
                <groupId>id.payu.shared</groupId>
                <artifactId>api-commons</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu.shared</groupId>
                <artifactId>quarkus-api-commons</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>events-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>security-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>resilience-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>cache-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>outbox-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>jms-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>saga-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>grpc-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>rest-client-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>logging-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>archunit-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>datasource-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>

            <!-- Spring Cloud Dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- REST Assured BOM (not in Spring Boot 4.1.0 BOM, added explicitly) -->
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured-bom</artifactId>
                <version>5.5.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers 2.0.5 BOM (artifact names changed to testcontainers-* prefix) -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j BOM (manages spring6 + spring-boot3 + core artifacts) -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j spring-boot4 (NOT in r4j-bom, must pin explicitly) -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Resilience4j spring6 (override Spring Cloud BOM's 2.3.0 pin to match our 2.4.0) -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring6</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Resilience4j core/annotations/consumer/framework-common (transitive pins not picked up from r4j-bom) -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-annotations</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-core</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-consumer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-framework-common</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circularbuffer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-ratelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Resilience4j -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-retry</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bulkhead</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-timelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- CloudEvents -->
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-core</artifactId>
                <version>${cloudevents.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-json-jackson</artifactId>
                <version>${cloudevents.version}</version>
            </dependency>

            <!-- Hypersistence Utils for JSONB (Hibernate 7.0) -->
            <dependency>
                <groupId>io.hypersistence</groupId>
                <artifactId>hypersistence-utils-hibernate-70</artifactId>
                <version>${hypersistence.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.hibernate.orm</groupId>
                        <artifactId>hibernate-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Spring Boot Auto-Configuration Classic (Jackson 2 + other legacy API support for SB 4.0+) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-autoconfigure-classic</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Logstash Logback Encoder for JSON Logging -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- MapStruct for compile-time type-safe mapping -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Jackson 2 versions are managed by SB 4.1.0's jackson-2-bom (do not override here) -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>

            <!-- ShedLock — distributed lock for @Scheduled methods to prevent
                 double-execution when multiple replicas run in HA. ITER-53. -->
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                    <version>${spring-cloud-contract.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <testMode>MOCKMVC</testMode>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.13</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>1.25.9</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>1.2.3</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>id.payu.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>id.payu.*</param>
                        </targetTests>
                        <mutators>
                            <mutator>DEFAULTS</mutator>
                        </mutators>
                        <outputFormats>
                            <outputFormat>HTML</outputFormat>
                            <outputFormat>XML</outputFormat>
                        </outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <mutationThreshold>60</mutationThreshold>
                        <coverageThreshold>70</coverageThreshold>
                        <threads>4</threads>
                        <excludedClasses>
                            <param>id.payu.*.config.*</param>
                            <param>id.payu.*Application</param>
                        </excludedClasses>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.openrewrite.maven</groupId>
                    <artifactId>rewrite-maven-plugin</artifactId>
                    <version>5.43.0</version>
                    <configuration>
                        <activeRecipes>
                            <recipe>org.openrewrite.java.spring.boot3.SpringBoot3BestPractices</recipe>
                        </activeRecipes>
                        <failOnDryRunResults>false</failOnDryRunResults>
                        <skip>true</skip>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.openrewrite.recipe</groupId>
                            <artifactId>rewrite-spring</artifactId>
                            <version>5.21.0</version>
                        </dependency>
                        <dependency>
                            <groupId>org.openrewrite.recipe</groupId>
                            <artifactId>rewrite-migrate-java</artifactId>
                            <version>2.27.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <!-- DEVSECOPS §4.1.3 SpotBugs + FindSecBugs — ponytail: report-only via -Pspotbugs, blocking via -Dspotbugs.failOnError, invariant gate-before-deploy -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.8.6.6</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <failOnError>true</failOnError>
                        <includeFilterFile>${maven.multiModuleProjectDirectory}/scripts/security/spotbugs-filter.xml</includeFilterFile>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>1.13.0</version>
                            </plugin>
                        </plugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs</artifactId>
                            <version>4.9.0</version>
                        </dependency>
                        <dependency>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.13.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Profile for building only shared libraries -->
        <profile>
            <id>shared-only</id>
            <modules>
                <module>shared/api-commons</module>
                <module>shared/events-starter</module>
                <module>shared/security-starter</module>
                <module>shared/resilience-starter</module>
                <module>shared/cache-starter</module>
                <module>shared/outbox-starter</module>
                <module>shared/saga-starter</module>
            </modules>
        </profile>

        <!-- Profile for building only simulators -->
        <profile>
            <id>simulators</id>
            <modules>
                <module>simulators/bi-fast-simulator</module>
                <module>simulators/biller-simulator</module>
                <module>simulators/dukcapil-simulator</module>
                <module>simulators/qris-simulator</module>
                <module>simulators/va-simulator</module>
            </modules>
        </profile>

        <!-- Profile for building only core services -->
        <profile>
            <id>services</id>
            <modules>
                <module>account-service</module>
                <module>auth-service</module>
                <module>product-catalog-service</module>
                <module>wallet-service</module>
                <module>transaction-service</module>
                <module>investment-service</module>
                <module>lending-service</module>
                        <module>statement-service</module>
                <module>billing-service</module>
                <module>notification-service</module>
                <module>gateway-service</module>
                <module>backoffice-service</module>
                <module>partner-service</module>
                <module>promotion-service</module>
                <module>support-service</module>
                <module>compliance-service</module>
                <module>fx-service</module>
                <module>cms-service</module>
                <module>api-portal-service</module>
                <module>dispute-service</module>
            </modules>
        </profile>

        <!-- Profile for mutation testing with PITest -->
        <profile>
            <id>mutation-testing</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- DEVSECOPS §4.1.3 SpotBugs + FindSecBugs (CICD-DRIFT-001) — ponytail: -Pspotbugs triggers verify:check, blocking=true via failOnError; report-only set -Dspotbugs.failOnError=false -->
        <profile>
            <id>spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotbugs-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
