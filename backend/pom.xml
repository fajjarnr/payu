<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>id.payu</groupId>
    <artifactId>payu-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PayU Backend Parent</name>
    <description>Parent POM for PayU Digital Banking Platform Backend Services</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Security Patches (RHACS Compliance) -->
        <jackson.version>2.18.6</jackson.version>
        <commons-io.version>2.18.0</commons-io.version>
        <commons-fileupload.version>1.6.0</commons-fileupload.version>

        <!-- PayU Shared Modules Versions -->
        <payu.shared.version>1.0.0-SNAPSHOT</payu.shared.version>

        <!-- Third-party Versions -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <cloudevents.version>4.0.1</cloudevents.version>
        <hypersistence.version>3.15.2</hypersistence.version>
        <spring-cloud.version>2025.0.2</spring-cloud.version>
        <springdoc.version>2.3.0</springdoc.version>
        <lombok.version>1.18.42</lombok.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
    </properties>

    <modules>
        <!-- Shared Libraries - Build First (No inter-dependencies) -->
        <module>shared/api-commons</module>
        <module>shared/events-starter</module>
        <module>shared/security-starter</module>
        <module>shared/resilience-starter</module>
        <module>shared/cache-starter</module>
        <module>shared/logging-starter</module>
        <module>shared/outbox-starter</module>
        <module>shared/saga-starter</module>
        <module>shared/archunit-starter</module>
        <module>shared/mapper-starter</module>
        <module>shared/grpc-starter</module>
        <module>shared/rest-client-starter</module>

        <!-- Simulators -->
        <module>simulators/bi-fast-simulator</module>
        <module>simulators/biller-simulator</module>
        <module>simulators/dukcapil-simulator</module>
        <module>simulators/qris-simulator</module>
        <module>simulators/va-simulator</module>

        <!-- Core Services -->
        <module>account-service</module>
        <module>auth-service</module>
        <module>product-catalog-service</module>
        <module>wallet-service</module>
        <module>transaction-service</module>
        <module>investment-service</module>
        <module>lending-service</module>
        <module>statement-service</module>
        <module>billing-service</module>
        <module>notification-service</module>
        <module>gateway-service</module>
        <module>backoffice-service</module>
        <module>partner-service</module>
        <module>promotion-service</module>
        <module>support-service</module>
        <module>compliance-service</module>
        <module>fx-service</module>
        <module>cms-service</module>
        <module>api-portal-service</module>
        <module>dispute-service</module>
        <module>integration-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- PayU Shared Modules -->
            <dependency>
                <groupId>id.payu.shared</groupId>
                <artifactId>api-commons</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>events-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>security-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>resilience-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>cache-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>outbox-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>saga-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>mapper-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>grpc-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>id.payu</groupId>
                <artifactId>rest-client-starter</artifactId>
                <version>${payu.shared.version}</version>
            </dependency>

            <!-- Spring Cloud Dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-retry</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bulkhead</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-timelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- CloudEvents -->
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-core</artifactId>
                <version>${cloudevents.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-json-jackson</artifactId>
                <version>${cloudevents.version}</version>
            </dependency>

            <!-- Hypersistence Utils for JSONB -->
            <dependency>
                <groupId>io.hypersistence</groupId>
                <artifactId>hypersistence-utils-hibernate-63</artifactId>
                <version>${hypersistence.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.hibernate.orm</groupId>
                        <artifactId>hibernate-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Logstash Logback Encoder for JSON Logging -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- MapStruct for compile-time type-safe mapping -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Jackson Security Patches (Explicit Management) -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jdk8</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.module</groupId>
                <artifactId>jackson-module-parameter-names</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.13</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>1.15.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>1.2.1</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>id.payu.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>id.payu.*</param>
                        </targetTests>
                        <mutators>
                            <mutator>DEFAULTS</mutator>
                        </mutators>
                        <outputFormats>
                            <outputFormat>HTML</outputFormat>
                            <outputFormat>XML</outputFormat>
                        </outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <mutationThreshold>60</mutationThreshold>
                        <coverageThreshold>70</coverageThreshold>
                        <threads>4</threads>
                        <excludedClasses>
                            <param>id.payu.*.config.*</param>
                            <param>id.payu.*Application</param>
                        </excludedClasses>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Profile for building only shared libraries -->
        <profile>
            <id>shared-only</id>
            <modules>
                <module>shared/api-commons</module>
                <module>shared/events-starter</module>
                <module>shared/security-starter</module>
                <module>shared/resilience-starter</module>
                <module>shared/cache-starter</module>
                <module>shared/outbox-starter</module>
                <module>shared/saga-starter</module>
            </modules>
        </profile>

        <!-- Profile for building only simulators -->
        <profile>
            <id>simulators</id>
            <modules>
                <module>simulators/bi-fast-simulator</module>
                <module>simulators/biller-simulator</module>
                <module>simulators/dukcapil-simulator</module>
                <module>simulators/qris-simulator</module>
                <module>simulators/va-simulator</module>
            </modules>
        </profile>

        <!-- Profile for building only core services -->
        <profile>
            <id>services</id>
            <modules>
                <module>account-service</module>
                <module>auth-service</module>
                <module>product-catalog-service</module>
                <module>wallet-service</module>
                <module>transaction-service</module>
                <module>investment-service</module>
                <module>lending-service</module>
                <module>statement-service</module>
                <module>billing-service</module>
                <module>notification-service</module>
                <module>gateway-service</module>
                <module>backoffice-service</module>
                <module>partner-service</module>
                <module>promotion-service</module>
                <module>support-service</module>
                <module>compliance-service</module>
                <module>fx-service</module>
                <module>cms-service</module>
                <module>api-portal-service</module>
                <module>dispute-service</module>
            </modules>
        </profile>

        <!-- Profile for mutation testing with PITest -->
        <profile>
            <id>mutation-testing</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
