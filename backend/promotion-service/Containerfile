####
# PayU promotion-service - Runtime Container
# Expects pre-built JAR: mvn -f backend/pom.xml clean package -DskipTests -pl promotion-service
####
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24-2

LABEL maintainer="backend-team@payu.fajjjar.my.id"
LABEL org.opencontainers.image.title="payu-promotion-service"
LABEL org.opencontainers.image.description="PayU promotion-service"
LABEL org.opencontainers.image.version="1.5.0"
LABEL org.opencontainers.image.vendor="PayU Indonesia"
LABEL org.opencontainers.image.source="https://github.com/payu/backend/promotion-service"
LABEL id.payu.service.tier="supporting"

USER 185
WORKDIR /deployments

COPY --chown=185 target/app.jar /deployments/app.jar

EXPOSE 8080

ENV SPRING_APPLICATION_NAME=promotion-service
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/deployments/heapdump.hprof \
    -Djava.security.egd=file:/dev/./urandom"

HEALTHCHECK --interval=30s --timeout=3s --start-period=90s --retries=3 \
    CMD curl -sf http://localhost:8080/actuator/health/liveness || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /deployments/app.jar"]
