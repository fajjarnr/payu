# ============================================
# Stage 1: Builder
# ============================================
FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.5.20 /uv /uv

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt ./
ENV UV_COMPILE_BYTECODE=1
RUN /uv pip install --system --no-cache -r requirements.txt

# Copy application source
COPY src/ /app/src/

# ============================================
# Stage 2: Runtime
# ============================================
FROM python:3.12-slim

# OCI Metadata Labels
LABEL org.opencontainers.image.title="PayU KYC Service"
LABEL org.opencontainers.image.vendor="PayU"

WORKDIR /app

# Install runtime dependencies for OpenCV (libGL, libglib) and PaddleOCR (libgomp)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY --from=builder /app/src /app/src

# Create user and directories
RUN useradd -m -u 1001 appuser && \
    mkdir -p /app/models /app/temp /app/uploads /app/logs && \
    chown -R appuser:appuser /app

USER 1001

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV LOG_LEVEL=INFO
ENV PYTHONPATH="/app/src"

VOLUME ["/app/models", "/app/temp", "/app/uploads", "/app/logs"]

WORKDIR /app/src

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "4"]
