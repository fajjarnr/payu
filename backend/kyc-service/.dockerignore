# ============================================
# PayU KYC Service - Python FastAPI Docker Ignore
# ============================================
# This file provides dockerignore patterns for the
# KYC service (Python FastAPI with ML/OCR components).

# --- Python Build Artifacts & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- PyCharm, JetBrains, VSCode ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.iml
.history/

# --- Jupyter Notebook ---
.ipynb_checkpoints
*.ipynb

# --- PyInstaller ---
*.manifest
*.spec

# --- Unit Test / Coverage Reports ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
*.pytest_cache

# --- Environments & Secrets ---
.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
*.crt
secrets/
*.secret
credentials.json
*.key
.secrets/
vault-token/

# --- Machine Learning / Model Files ---
models/
checkpoints/
*.pth
*.pkl
*.onnx
*.h5
*.pb
*.savedmodel
*.safetensors
!models/.gitkeep

# --- Data & Datasets ---
data/
datasets/
*.csv
*.jsonl
*.parquet
!data/.gitkeep

# --- Logs ---
*.log
logs/
log/*.log
*.log.*

# --- Documentation ---
*.md
README.md
CHANGELOG.md
LICENSE
docs/
!docs/build/
docs/_build/

# --- Docker (prevent self-inclusion) ---
Dockerfile*
.dockerignore
docker-compose*.yml

# --- Git ---
.git/
.gitignore
.gitattributes
.github/

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Database ---
*.db
*.sqlite
*.sqlite3

# --- MyPy & Type Checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# --- Ruff (Python Linter) ---
.ruff_cache/

# --- CI/CD ---
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.jenkinsfile
.circleci/

# --- Misc ---
.editorconfig
*.bak
*.tmp
temp/
tmp/

# --- MLflow (if used) ---
mlruns/
mlflow.db

# --- Weights & Biases (if used) ---
wandb/
