# PayU Digital Banking - Pre-Prod Environment Variables Template
# ============================================================================
# Copy this file to .env and configure for Pre-Production.
# Mirror of production settings (strict security, TLS, Vault).
# ============================================================================

# Build Metadata
BUILD_DATE=2026-07-02T00:00:00Z
GIT_COMMIT=preprod-commit-sha
VERSION=1.8.71-rc1

# Application Settings
APP_ENV=preprod
APP_DEBUG=false
LOG_LEVEL=info
TZ=Asia/Jakarta

# Database - PostgreSQL (Pre-Prod Settings)
POSTGRES_HOST=payu-postgres-preprod.payu-db-preprod.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=payu_preprod_app
POSTGRES_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
POSTGRES_DB=payu_preprod
POSTGRES_SSL_MODE=verify-full

# TimescaleDB (Analytics Service - Pre-Prod)
TIMESCALE_HOST=payu-timescale-preprod.payu-db-preprod.svc.cluster.local
TIMESCALE_PORT=5433
TIMESCALE_USER=payu_analytics_preprod_app
TIMESCALE_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
TIMESCALE_DB=payu_analytics_preprod
TIMESCALE_SSL_MODE=verify-full

# Cache - Redis (Pre-Prod Settings)
REDIS_HOST=payu-redis-preprod.payu-cache-preprod.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT
REDIS_DB=0
REDIS_SSL=true

# Message Broker - Kafka (Pre-Prod Settings)
KAFKA_BOOTSTRAP_SERVERS=payu-kafka-preprod-kafka-bootstrap.payu-messaging-preprod.svc.cluster.local:9092
KAFKA_GROUP_ID=payu-services-preprod
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=payu-client-preprod
KAFKA_SASL_PASSWORD=REQUIRED_SECURE_PASSWORD_FROM_VAULT

# Secrets - HashiCorp Vault (Pre-Prod Settings)
VAULT_ADDR=https://vault-preprod.payu-security-preprod.svc.cluster.local:8200
VAULT_ROLE=payu-service-role-preprod
VAULT_AUTH_METHOD=kubernetes

# External Sandbox/Production Partner APIs (Real Sandbox or Dedicated Test Endpoints)
BIFAST_API_URL=https://api-preprod.bifast.or.id/v1
BIFAST_CLIENT_ID=REQUIRED_PREPROD_CLIENT_ID
BIFAST_CLIENT_SECRET=REQUIRED_PREPROD_SECRET
BIFAST_TIMEOUT=15000

DUKCAPIL_API_URL=https://api-preprod.dukcapil.kemendagri.go.id/v1
DUKCAPIL_API_KEY=REQUIRED_PREPROD_API_KEY
DUKCAPIL_TIMEOUT=10000

QRIS_API_URL=https://api-preprod.qris-processor.co.id/v1
QRIS_MERCHANT_ID=REQUIRED_PREPROD_MERCHANT_ID
QRIS_CLIENT_ID=REQUIRED_PREPROD_CLIENT_ID
QRIS_CLIENT_SECRET=REQUIRED_PREPROD_SECRET
QRIS_TIMEOUT=15000

# Observability - OpenTelemetry (Pre-Prod Settings)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-preprod.payu-monitoring-preprod.svc.cluster.local:4317
OTEL_SERVICE_NAME=payu-core-service-preprod
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2  # Sample 20% of traces in pre-prod

# Feature Flags
FEATURE_BIFAST_ENABLED=true
FEATURE_QRIS_ENABLED=true
FEATURE_VIRTUAL_CARDS_ENABLED=true
FEATURE_INVESTMENT_ENABLED=false
FEATURE_LENDING_ENABLED=false
FEATURE_FX_TRADING_ENABLED=false
FEATURE_EXPERIMENTAL_UI_ENABLED=false
FEATURE_BETA_ANALYTICS_ENABLED=false
