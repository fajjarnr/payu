# ============================================
# PayU Platform - Root Docker Ignore Patterns
# ============================================
# This file provides global dockerignore patterns for the entire PayU platform.
# Service-specific .dockerignore files should be placed in individual service directories.

# --- Version Control ---
.git
.gitignore
.gitattributes
.github

# --- Build Artifacts - Java/Maven ---
target/
!target/*.jar
!target/quarkus-app/
.m2/
*.class
*.jar
*.war
*.ear

# --- Build Artifacts - Node.js/npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
out/
build/
dist/
.turbo/

# --- Build Artifacts - Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# --- Testing & Coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
.vitest/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.pytest_cache

# --- Environment & Secrets ---
.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
*.crt
secrets/
*.secret
credentials.json

# --- Logs & Temporary Files ---
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~
.npm/
.eslintcache

# --- IDE & Editor Files ---
.vscode/
.idea/
.settings/
.project
.classpath
.factorypath
*.iml
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
.desktop.ini
*.code-workspace

# --- Documentation (exclude from build context) ---
*.md
README.md
CHANGELOG.md
LICENSE
docs/
!docs/build/

# --- CI/CD ---
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.jenkinsfile
.circleci/

# --- Docker Files (prevent self-inclusion) ---
Dockerfile*
docker-compose*.yml
.dockerignore

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Misc ---
.editorconfig
.prettierignore
.eslintrc*
.prettierrc*
