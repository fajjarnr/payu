# Podman Build Configuration
# =========================
# Copy this file to .env and customize for your environment

# Build Settings
PODMAN_PLATFORM=linux/amd64
PODMAN_NETWORK=podman
JOBS=4

# Registry Settings
REGISTRY=localhost
TAG=1.5.0

# Build Arguments
BUILD_ARGS=""
BUILD_STAGE=""

# Security Settings
PODMAN_USE_POD=false
PODMAN_USERNS=keep-id

# Trivy Settings
TRIVY_CACHE_DIR=/tmp/trivy-cache
TRIVY_TIMEOUT=300s
TRIVY_SKIP_UPDATE=false

# Scan Settings
SEVERITY=CRITICAL,HIGH,MEDIUM
SCAN_FORMAT=table

# Database
POSTGRES_USER=payu
POSTGRES_PASSWORD=payu_secret
POSTGRES_DB=payu_account

# Redis / Cache
REDIS_PASSWORD=payu-cache-dev-password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=payu-backend-secret

# Encryption
ENCRYPTION_KEY=payu-dev-encryption-key-change-in-production-minimum-32-chars

# JWT
JWT_SECRET=dev_jwt_secret_must_be_long_enough_for_dev_only_usage

# Gateway
GATEWAY_URL=http://gateway-service:8080

# S3 / RustFS
S3_ACCESS_KEY=payu-admin
S3_SECRET_KEY=payu-secret-key-change-me

# Vault
VAULT_DEV_ROOT_TOKEN_ID=dev-only-token
