# Generated quadlet file for auth-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/auth-service:dev
ContainerName=auth-service
AutoUpdate=registry
Network=payu-network
PodmanArgs=--label=io.payu.service=auth-service
# Add your custom arguments below
# EnvironmentFile=/auth-service/env
# Volume=/auth-service/config:/etc/auth-service:ro
# Volume=/auth-service/data:/var/lib/auth-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network payu-network
ExecStartPre=/usr/bin/podman pull localhost/auth-service:dev

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
