# Generated quadlet file for account-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/account-service:dev
ContainerName=account-service
AutoUpdate=registry
Network=payu-network
PodmanArgs=--label=io.payu.service=account-service
# Add your custom arguments below
# EnvironmentFile=/account-service/env
# Volume=/account-service/config:/etc/account-service:ro
# Volume=/account-service/data:/var/lib/account-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network payu-network
ExecStartPre=/usr/bin/podman pull localhost/account-service:dev

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
