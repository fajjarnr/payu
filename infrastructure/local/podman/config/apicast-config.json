{
  "services": [
    {
      "id": 1,
      "proxy": {
        "hosts": [
          "apicast",
          "localhost"
        ],
        "api_backend": "http://gateway-service:8080",
        "policy_chain": [
          {
            "name": "apicast.policy.upstream",
            "version": "builtin",
            "configuration": {
              "rules": [
                {
                  "regex": "/",
                  "url": "http://gateway-service:8080"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
