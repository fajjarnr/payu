[Unit]
Description=PayU Kafka Broker (KRaft mode)
After=network.target container.service
Requires=network.target container.service
PartOf=podman-payu.service

[Container]
Image=confluentinc/cp-kafka:7.7.1
ContainerName=payu-kafka
PodmanArgs=--pod=payu-messaging-pod --net=payu-network
Network=payu-network
EnvFile=-/home/ubuntu/payu/.env
# KRaft mode - no Zookeeper dependency (aligned with AMQ Streams on OpenShift)
Environment=KAFKA_NODE_ID=1
Environment=KAFKA_PROCESS_ROLES=broker,controller
Environment=KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
Environment=KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
Environment=KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
Environment=KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,PLAINTEXT_HOST://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
Environment=KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
Environment=KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
Environment=KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
Environment=KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
Environment=KAFKA_HEAP_OPTS=-Xmx1G -Xms1G
Environment=CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
Port=9092:9092
Port=29092:29092
HealthCmd=kafka-broker-api-versions --bootstrap-server localhost:9092
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=60s
HealthRetries=5
AutoUpdate=registry

[Install]
WantedBy=podman-payu.service
