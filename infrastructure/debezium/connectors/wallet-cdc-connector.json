{
  "name": "payu-wallet-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "3",
    "database.hostname": "${file:/secrets/debezium/db-credentials:hostname}",
    "database.port": "${file:/secrets/debezium/db-credentials:port}",
    "database.user": "${file:/secrets/debezium/db-credentials:username}",
    "database.password": "${file:/secrets/debezium/db-credentials:password}",
    "database.dbname": "${file:/secrets/debezium/db-credentials:database}",
    "database.server.name": "payu",
    "database.server.id": "184056",
    "plugin.name": "pgoutput",
    "slot.name": "debezium_wallet_slot",
    "publication.name": "dbz_wallet_publication",
    "table.include.list": "public.wallets,public.ledger_entries,public.wallet_transactions",
    "tombstones.on.delete": "true",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "INSERT INTO public.debezium_heartbeat (id, updated_at) VALUES (1, NOW()) ON CONFLICT (id) DO UPDATE SET updated_at = EXCLUDED.updated_at;",
    "transforms": "unwrap,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,source.ts_ms,db,table,source.lsn",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "([^.]+)\\.([^.]+)\\.([^.]+)",
    "transforms.route.replacement": "payu.wallet.cdc.$3",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "errors.deadletterqueue.topic.name": "payu.wallet.cdc.dlq",
    "errors.deadletterqueue.context.headers.enable": "true",
    "max.batch.size": "4096",
    "max.queue.size": "16384",
    "poll.interval.ms": "500",
    "retriable.restart.connector.wait.ms": "10000",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "minimal",
    "snapshot.fetch.size": "10000",
    "decimal.handling.mode": "string",
    "time.precision.mode": "connect",
    "binary.handling.mode": "base64",
    "column.exclude.list": "public.wallets.pin_hash,public.wallets.security_question_hash,public.wallets.biometric_hash",
    "column.mask.hash.user_id.with": "sha256",
    "column.truncate.to.1024.chars": "public.ledger_entries.description,public.wallet_transactions.metadata",
    "skipped.operations": "none",
    "provide.transaction.metadata": "true"
  }
}
