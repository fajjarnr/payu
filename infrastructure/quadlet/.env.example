# Podman Build Configuration
# =========================
# Copy this file to .env and customize for your environment

# Build Settings
PODMAN_PLATFORM=linux/amd64
PODMAN_NETWORK=podman
JOBS=4

# Registry Settings
REGISTRY=localhost
TAG=1.4.0

# Build Arguments
BUILD_ARGS=""
BUILD_STAGE=""

# Security Settings
PODMAN_USE_POD=false
PODMAN_USERNS=keep-id

# Trivy Settings
TRIVY_CACHE_DIR=/tmp/trivy-cache
TRIVY_TIMEOUT=300s
TRIVY_SKIP_UPDATE=false

# Scan Settings
SEVERITY=CRITICAL,HIGH,MEDIUM
SCAN_FORMAT=table
