# Generated quadlet file for dukcapil-simulator
# This file can be used with systemd to manage the container

[Container]
Image=localhost/dukcapil-simulator:test
ContainerName=dukcapil-simulator
AutoUpdate=registry
Network=podman
PodmanArgs=--network=host --label=io.payu.service=dukcapil-simulator
# Add your custom arguments below
# EnvironmentFile=/dukcapil-simulator/env
# Volume=/dukcapil-simulator/config:/etc/dukcapil-simulator:ro
# Volume=/dukcapil-simulator/data:/var/lib/dukcapil-simulator

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network podman
ExecStartPre=/usr/bin/podman pull localhost/dukcapil-simulator:test

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
