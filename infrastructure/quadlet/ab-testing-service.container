# Generated quadlet file for ab-testing-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/ab-testing-service:latest
ContainerName=ab-testing-service
AutoUpdate=registry
Network=podman
PodmanArgs=--network=host --label=io.payu.service=ab-testing-service
# Add your custom arguments below
# EnvironmentFile=/ab-testing-service/env
# Volume=/ab-testing-service/config:/etc/ab-testing-service:ro
# Volume=/ab-testing-service/data:/var/lib/ab-testing-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network podman
ExecStartPre=/usr/bin/podman pull localhost/ab-testing-service:latest

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
