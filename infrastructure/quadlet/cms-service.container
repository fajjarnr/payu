# Generated quadlet file for cms-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/cms-service:dev
ContainerName=cms-service
AutoUpdate=registry
Network=payu-network
PodmanArgs=--label=io.payu.service=cms-service
# Add your custom arguments below
# EnvironmentFile=/cms-service/env
# Volume=/cms-service/config:/etc/cms-service:ro
# Volume=/cms-service/data:/var/lib/cms-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network payu-network
ExecStartPre=/usr/bin/podman pull localhost/cms-service:dev

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
