# PayU Kafka - Quadlet Container File

[Container]
Image=docker.io/confluentinc/cp-kafka:7.5.0
ContainerName=payu-kafka
AutoUpdate=registry
Network=payu-network

# Port mapping
PublishPort=9092:9092
PublishPort=29092:29092

# Environment variables
Environment=KAFKA_BROKER_ID=1
Environment=KAFKA_ZOOKEEPER_CONNECT=payu-zookeeper:2181
Environment=KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
Environment=KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://payu-kafka:29092,PLAINTEXT_HOST://localhost:9092
Environment=KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
Environment=KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
Environment=KAFKA_HEAP_OPTS=-Xmx1G -Xms1G

# Health check
HealthCmd=kafka-broker-api-versions --bootstrap-server localhost:9092
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=30s

# Resource limits
Memory=2G
MemorySwap=3G

# Security options
NoNewPrivileges=true

# Logging
LogDriver=journald
LogOpt=tag=kafka

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=60s

# Ensure zookeeper is started first
ExecStartPre=/usr/bin/podman start payu-zookeeper

[Install]
WantedBy=default.target
