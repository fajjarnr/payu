# Generated quadlet file for lending-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/lending-service:dev
ContainerName=lending-service
AutoUpdate=registry
Network=payu-network
PodmanArgs=--label=io.payu.service=lending-service
# Add your custom arguments below
# EnvironmentFile=/lending-service/env
# Volume=/lending-service/config:/etc/lending-service:ro
# Volume=/lending-service/data:/var/lib/lending-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network payu-network
ExecStartPre=/usr/bin/podman pull localhost/lending-service:dev

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
