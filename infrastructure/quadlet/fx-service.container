# Generated quadlet file for fx-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/fx-service:dev
ContainerName=fx-service
AutoUpdate=registry
Network=payu-network
PodmanArgs=--label=io.payu.service=fx-service
# Add your custom arguments below
# EnvironmentFile=/fx-service/env
# Volume=/fx-service/config:/etc/fx-service:ro
# Volume=/fx-service/data:/var/lib/fx-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network payu-network
ExecStartPre=/usr/bin/podman pull localhost/fx-service:dev

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
