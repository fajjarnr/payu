# PayU Wallet Service - Quadlet Container File
# Core ledger and balance management service

[Container]
Image=registry.payu.internal/payu/wallet-service:latest
ContainerName=payu-wallet-service
AutoUpdate=registry
Network=payu-network

# Port mapping
PublishPort=8004:8004

# Environment variables
Environment=SPRING_DATASOURCE_URL=jdbc:postgresql://payu-postgres:5432/payu_wallet
Environment=SPRING_DATASOURCE_USERNAME=payu
Environment=SPRING_KAFKA_BOOTSTRAP_SERVERS=payu-kafka:29092
Environment=OTEL_ENDPOINT=http://payu-jaeger:4317
Environment=JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.security.egd=file:/dev/./urandom

# Health check
HealthCmd=curl -f http://localhost:8004/actuator/health/liveness || exit 1
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s

# Resource limits - higher for ledger operations
Memory=1.5G
MemorySwap=3G
CPUShares=2048

# Security options
NoNewPrivileges=true
RunInit=true

# Logging
LogDriver=journald
LogOpt=tag=wallet-service

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Resource limits
MemoryMax=2G

[Install]
WantedBy=default.target
