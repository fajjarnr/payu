# Generated quadlet file for backoffice-service
# This file can be used with systemd to manage the container

[Container]
Image=localhost/backoffice-service:dev
ContainerName=backoffice-service
AutoUpdate=registry
Network=payu-network
PodmanArgs=--label=io.payu.service=backoffice-service
# Add your custom arguments below
# EnvironmentFile=/backoffice-service/env
# Volume=/backoffice-service/config:/etc/backoffice-service:ro
# Volume=/backoffice-service/data:/var/lib/backoffice-service

[Service]
# Restart on failure, after 5 seconds
Restart=on-failure
RestartSec=5s

# Health check
ExecStartPre=/usr/bin/podman check-network payu-network
ExecStartPre=/usr/bin/podman pull localhost/backoffice-service:dev

# Set resource limits
# LimitMEM=512M
# LimitCPU=1.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=default.target
