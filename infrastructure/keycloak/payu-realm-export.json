{
  "realm": "payu",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard customer user role",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "ADMIN",
        "description": "Administrator role with full access",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "BACKOFFICE",
        "description": "Backoffice staff role",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "KYC_VERIFIED",
        "description": "User with completed KYC verification",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "PREMIUM",
        "description": "Premium user with access to investment and lending",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      }
    ]
  },
  "users": [
    {
      "username": "customer1",
      "enabled": true,
      "emailVerified": true,
      "email": "customer1@payu.id",
      "firstName": "Customer",
      "lastName": "One",
      "attributes": {
        "phoneNumber": ["+6281234567890"],
        "nik": ["3201234567890001"],
        "externalId": ["EXT-CUST-001"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "$(env.KEYCLOAK_TEST_USER_PASSWORD:-P@ssw0rd123)",
          "temporary": false
        }
      ],
      "realmRoles": ["USER", "KYC_VERIFIED", "PREMIUM"],
      "clientRoles": {},
      "groups": []
    },
    {
      "username": "customer2",
      "enabled": true,
      "emailVerified": true,
      "email": "customer2@payu.id",
      "firstName": "Customer",
      "lastName": "Two",
      "attributes": {
        "phoneNumber": ["+6281234567891"],
        "nik": ["3201234567890002"],
        "externalId": ["EXT-CUST-002"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "$(env.KEYCLOAK_TEST_USER_PASSWORD:-P@ssw0rd123)",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"],
      "clientRoles": {},
      "groups": []
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@payu.id",
      "firstName": "System",
      "lastName": "Administrator",
      "attributes": {
        "phoneNumber": ["+628111111111"],
        "externalId": ["EXT-ADMIN-001"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "$(env.KEYCLOAK_TEST_USER_PASSWORD:-P@ssw0rd123)",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "USER"],
      "clientRoles": {},
      "groups": []
    },
    {
      "username": "backoffice",
      "enabled": true,
      "emailVerified": true,
      "email": "backoffice@payu.id",
      "firstName": "Backoffice",
      "lastName": "Staff",
      "attributes": {
        "phoneNumber": ["+628222222222"],
        "employeeId": ["EMP-001"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "$(env.KEYCLOAK_TEST_USER_PASSWORD:-P@ssw0rd123)",
          "temporary": false
        }
      ],
      "realmRoles": ["BACKOFFICE", "USER"],
      "clientRoles": {},
      "groups": []
    }
  ],
  "clients": [
    {
      "clientId": "payu-web-app",
      "name": "PayU Web Application",
      "description": "Next.js 15 web application for PayU Digital Banking",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env.KEYCLOAK_WEB_CLIENT_SECRET:-payu-web-secret-dev-only)",
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "user-profile-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "preferred_username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "phone",
          "protocol": "openid-connect",
          "protocolMapper": "user-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "phoneNumber",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "phone_number",
            "jsonType.label": "String"
          }
        },
        {
          "name": "nik",
          "protocol": "openid-connect",
          "protocolMapper": "user-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "nik",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "nik",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "payu-backend",
      "name": "PayU Backend Services",
      "description": "Backend microservices for PayU platform",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env.KEYCLOAK_BACKEND_CLIENT_SECRET:-secret)",
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "attributes": {},
      "protocol": "openid-connect"
    },
    {
      "clientId": "payu-mobile",
      "name": "PayU Mobile App",
      "description": "React Native mobile application",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env.KEYCLOAK_MOBILE_CLIENT_SECRET:-payu-mobile-secret-dev-only)",
      "redirectUris": ["payu://auth/*", "exp://payu.auth/*"],
      "webOrigins": ["payu://auth", "exp://payu.auth"],
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {},
      "protocol": "openid-connect"
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  }
}
