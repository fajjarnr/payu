<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs Filter Configuration for PayU
  effort="max" and threshold="medium" should be set in the Maven plugin configuration:
    <plugin>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-maven-plugin</artifactId>
      <configuration>
        <effort>Max</effort>
        <threshold>Medium</threshold>
        <includeFilterFile>spotbugs-filter.xml</includeFilterFile>
      </configuration>
    </plugin>
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- ================================================================ -->
    <!-- Category-level matches: ensure all critical categories are caught -->
    <!-- ================================================================ -->

    <!-- Security-related bugs that should always be reported -->
    <Match>
        <Bug category="SECURITY"/>
        <Priority value="1"/>
    </Match>

    <!-- Malicious code vulnerabilities (mutable static fields, exposed internals) -->
    <Match>
        <Bug category="MALICIOUS_CODE"/>
        <Priority value="1"/>
    </Match>

    <!-- Performance issues (inefficient operations, unnecessary object creation) -->
    <Match>
        <Bug category="PERFORMANCE"/>
    </Match>

    <!-- Correctness issues (likely bugs, null pointer dereferences) -->
    <Match>
        <Bug category="CORRECTNESS"/>
    </Match>

    <!-- Multi-threading correctness (race conditions, synchronization) -->
    <Match>
        <Bug category="MT_CORRECTNESS"/>
    </Match>

    <!-- ================================================================ -->
    <!-- Specific pattern matches for high-priority security issues       -->
    <!-- ================================================================ -->

    <!-- SQL Injection vulnerabilities -->
    <Match>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>

    <!-- Command Injection -->
    <Match>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>

    <!-- Path Traversal -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- Weak cryptographic algorithms -->
    <Match>
        <Bug pattern="WEAK_ENC"/>
    </Match>

    <!-- Hardcoded passwords/keys -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD"/>
    </Match>

    <!-- XSS vulnerabilities -->
    <Match>
        <Bug category="XSS"/>
        <Priority value="1"/>
    </Match>

    <!-- ================================================================ -->
    <!-- Exclusions: Reduce noise from generated/test code                -->
    <!-- ================================================================ -->

    <!-- Ignore false positives in generated code -->
    <Match>
        <Class name="~.*\..*_.+"/>
    </Match>

    <!-- Ignore low priority issues in test code -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
